---
import { Icon } from 'astro-icon/components';
---

<button
  id="go-top-btn"
  aria-label="Go to Top"
  class="fixed bottom-6 right-6 z-50 p-3 rounded-full bg-gold-500 text-white shadow-lg cursor-pointer transition-all duration-300 opacity-0 translate-y-10 hover:bg-gold-600 border border-transparent hidden"
>
  <Icon name="tabler:arrow-up" class="w-6 h-6" />
</button>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('go-top-btn');

    if (btn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          btn.classList.remove('hidden', 'opacity-0', 'translate-y-10');
          btn.classList.add('opacity-100', 'translate-y-0');
        } else {
          btn.classList.add('opacity-0', 'translate-y-10');
          setTimeout(() => {
            if (window.scrollY <= 300) btn.classList.add('hidden');
          }, 300);
        }
      });

      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
