---
import fortuneData from '~/data/zh-TW/fortunes.json';

import imgShengJiao from '~/assets/images/divination/divination_sheng_jiao.png';
import imgXiaoJiao from '~/assets/images/divination/divination_xiao_jiao.png';
import imgYinJiao from '~/assets/images/divination/divination_yin_jiao.png';
import qianshiContainer from '~/assets/images/divination/qianshi_container.png';

const { class: className = '', lang = 'zh-TW' } = Astro.props;

const allLabels: Record<string, Record<string, string>> = {
  'zh-TW': {
    sectionBlocks: '擲筊問事',
    sectionFortune: '求籤解惑',
    instruction: '請默念問題後點擊下方按鈕',
    btnThrow: '誠心擲筊',
    throwing: '擲筊中...',
    holy: '聖筊',
    holyMeaning: '神明同意、吉祥之兆',
    laughing: '笑筊',
    laughingMeaning: '神明一笑、狀況不明或不需要',
    angry: '陰筊',
    angryMeaning: '神明否定、時機未到或不宜',
    stickPrefix: '第',
    stickSuffix: '籤',
    confirmInstruction: '請擲筊確認是否為此籤',
    failMessage: '非聖筊，此籤不是您的，請重新求籤。',
    btnDrawAgain: '重新求籤',
    btnDraw: '開始求籤',
    btnConfirm: '擲筊確認',
    confirmNote: '需擲出聖筊 (一正一反) 才算確認',
    btnReset: '重新求籤',
    drawingStick: '正在搖籤筒...',
    confirmingBlock: '擲筊確認中...',
  },
  en: {
    sectionBlocks: 'Moon Blocks',
    sectionFortune: 'Fortune Sticks',
    instruction: 'Focus on your question, then click below',
    btnThrow: 'Cast Moon Blocks',
    throwing: 'Casting...',
    holy: 'Holy Block',
    holyMeaning: 'The deity approves — an auspicious sign',
    laughing: 'Laughing Block',
    laughingMeaning: 'The deity laughs — unclear or not needed',
    angry: 'Angry Block',
    angryMeaning: 'The deity declines — not the right time',
    stickPrefix: 'Stick #',
    stickSuffix: '',
    confirmInstruction: 'Cast moon blocks to confirm this stick',
    failMessage: 'Not a Holy Block — this fortune is not yours. Please draw again.',
    btnDrawAgain: 'Draw Again',
    btnDraw: 'Draw Fortune Stick',
    btnConfirm: 'Cast to Confirm',
    confirmNote: 'A Holy Block (one flat, one round) is needed',
    btnReset: 'Draw Again',
    drawingStick: 'Shaking the container...',
    confirmingBlock: 'Casting moon blocks...',
  },
  ja: {
    sectionBlocks: '筊杯占い',
    sectionFortune: 'おみくじ',
    instruction: '心の中で質問を唱えてボタンを押してください',
    btnThrow: '筊杯を投げる',
    throwing: '占い中...',
    holy: '聖筊',
    holyMeaning: '神様が同意 — 吉兆',
    laughing: '笑筊',
    laughingMeaning: '神様が微笑み — 不明確',
    angry: '陰筊',
    angryMeaning: '神様が否定 — 時期尚早',
    stickPrefix: '第',
    stickSuffix: '番',
    confirmInstruction: '筊杯を投げて確認してください',
    failMessage: '聖筊ではありません。もう一度引いてください。',
    btnDrawAgain: 'もう一度引く',
    btnDraw: 'おみくじを引く',
    btnConfirm: '筊杯で確認',
    confirmNote: '聖筊（一平一丸）が必要です',
    btnReset: 'もう一度引く',
    drawingStick: 'おみくじ筒を振っています...',
    confirmingBlock: '筊杯を投げています...',
  },
};
const labels = allLabels[lang] || allLabels['zh-TW'];

const uid = `div-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`divination-container ${className}`} data-divination-id={uid}>
  <!-- Section 1: 擲筊問事 (Moon Blocks) -->
  <div class="mb-8">
    <h3 class="text-lg font-serif font-bold text-red-900 dark:text-red-300 mb-4 flex items-center gap-2">
      <span class="w-1 h-6 bg-red-700 rounded-full"></span>
      {labels.sectionBlocks}
    </h3>
    <div class="space-y-4 text-center">
      <div
        class="monitor min-h-[12rem] flex items-center justify-center bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 relative overflow-hidden"
      >
        <div class="zhibei-result-area flex gap-4 items-center justify-center transition-all duration-500 px-2">
          <div class="text-gray-400 text-sm">{labels.instruction}</div>
        </div>
        <div
          class="zhibei-text absolute bottom-2 left-0 right-0 text-center font-bold text-lg sm:text-xl text-primary-700 opacity-0 transition-opacity duration-300 px-2"
        >
        </div>
      </div>

      <button
        class="btn-zhibei w-full px-4 sm:px-8 py-3 bg-red-700 hover:bg-red-800 text-white rounded-full font-bold text-base sm:text-lg shadow-md transition-transform transform active:scale-95 flex items-center justify-center mx-auto gap-2"
      >
        <span>🙌</span> {labels.btnThrow}
      </button>

      <div class="zhibei-meaning text-gray-600 dark:text-gray-400 text-sm mt-2 min-h-[1.5rem]"></div>
    </div>
  </div>

  <!-- Divider -->
  <div class="flex items-center gap-3 mb-8">
    <div class="flex-1 h-px bg-gray-200 dark:bg-gray-600"></div>
    <div class="w-2 h-2 rounded-full bg-red-300 dark:bg-red-700"></div>
    <div class="flex-1 h-px bg-gray-200 dark:bg-gray-600"></div>
  </div>

  <!-- Section 2: 求籤解惑 (Fortune Sticks) — Unified Flow -->
  <div>
    <h3 class="text-lg font-serif font-bold text-red-900 dark:text-red-300 mb-4 flex items-center gap-2">
      <span class="w-1 h-6 bg-red-700 rounded-full"></span>
      {labels.sectionFortune}
    </h3>
    <div class="space-y-4 text-center">
      <div
        class="monitor min-h-[14rem] flex flex-col items-center justify-center bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600 relative overflow-hidden p-4"
      >
        <!-- Step 1: Container (initial state) -->
        <div class="qianshi-container-view transition-all duration-500">
          <img src={qianshiContainer.src} alt="Fortune Stick Container" class="w-28 h-auto mx-auto drop-shadow-md" />
        </div>

        <!-- Step 2: Stick drawn + auto moon block confirmation -->
        <div class="qianshi-stick-view hidden flex-col items-center animate-fade-in-up">
          <div
            class="stick bg-yellow-100 border-2 border-yellow-600 text-yellow-900 px-3 py-6 rounded-full writing-vertical-rl font-serif font-bold text-lg shadow-md min-h-[120px] flex items-center justify-center border-double mb-3"
          >
            <span class="stick-number"></span>
          </div>
          <div class="text-gray-600 dark:text-gray-400 text-sm mb-2 px-2">{labels.confirmInstruction}</div>
          <!-- Moon block result appears here automatically -->
          <div class="confirm-block-area hidden mt-3 animate-fade-in-up">
            <div class="confirm-block-img flex gap-4 items-center justify-center mb-2 min-h-[64px]"></div>
            <p class="confirm-block-text text-lg font-bold mb-1"></p>
          </div>
        </div>

        <!-- Step 3: Fail Result -->
        <div class="qianshi-fail-view hidden flex-col items-center animate-fade-in-up w-full">
          <div class="qianshi-fail-blocks flex gap-4 items-center justify-center mb-3 min-h-[64px]"></div>
          <p class="qianshi-fail-text text-lg font-bold text-gray-700 mb-1"></p>
          <p class="text-gray-500 dark:text-gray-400 text-sm mb-3 px-2">{labels.failMessage}</p>
          <button
            class="btn-draw-again px-5 py-2.5 bg-red-700 hover:bg-red-800 text-white rounded-full shadow-md transition-colors text-sm font-medium"
          >
            {labels.btnDrawAgain}
          </button>
        </div>

        <!-- Confirmed indicator (brief) -->
        <div class="qianshi-confirmed hidden flex-col items-center animate-fade-in-up">
          <div class="text-green-600 dark:text-green-400 text-4xl mb-2">✓</div>
          <p class="text-green-700 dark:text-green-300 font-bold">{labels.holy}</p>
        </div>
      </div>

      <div class="qianshi-controls">
        <button
          class="btn-draw w-full px-4 sm:px-8 py-3 bg-red-700 hover:bg-red-800 border-2 border-red-900 text-white rounded-full font-bold text-base sm:text-lg shadow-md transition-transform transform active:scale-95 flex items-center justify-center mx-auto gap-2"
        >
          <span>📜</span> {labels.btnDraw}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .writing-vertical-rl {
    writing-mode: vertical-rl;
    text-orientation: upright;
  }
  @keyframes shake {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(5deg); }
    50% { transform: rotate(0deg); }
    75% { transform: rotate(-5deg); }
    100% { transform: rotate(0deg); }
  }
  .animate-shake {
    animation: shake 0.5s ease-in-out infinite;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.4s ease-out;
  }
</style>

<script
  define:vars={{
    uid,
    shengJiaoSrc: imgShengJiao.src,
    xiaoJiaoSrc: imgXiaoJiao.src,
    yinJiaoSrc: imgYinJiao.src,
    fortuneData,
    labels,
  }}
>
  (function () {
    const root = document.querySelector(`[data-divination-id="${uid}"]`);
    if (!root) return;

    const q = (sel) => root.querySelector(sel);

    const btnZhibei = q('.btn-zhibei');
    const resultArea = q('.zhibei-result-area');
    const resultText = q('.zhibei-text');
    const meaningText = q('.zhibei-meaning');
    const btnDraw = q('.btn-draw');
    const containerView = q('.qianshi-container-view');
    const stickView = q('.qianshi-stick-view');
    const stickNumberEl = q('.stick-number');
    const qianshiControls = q('.qianshi-controls');
    const confirmedView = q('.qianshi-confirmed');
    const failView = q('.qianshi-fail-view');
    const failBlocks = q('.qianshi-fail-blocks');
    const failText = q('.qianshi-fail-text');
    const btnDrawAgain = q('.btn-draw-again');
    const confirmBlockArea = q('.confirm-block-area');
    const confirmBlockImg = q('.confirm-block-img');
    const confirmBlockText = q('.confirm-block-text');

    let currentStick = null;

    function getZhibeiResult() {
      const r = Math.random();
      if (r < 0.5) return 'holy';
      if (r < 0.75) return 'laughing';
      return 'anger';
    }

    function renderBlocks(result) {
      let imgSrc;
      if (result === 'holy') imgSrc = shengJiaoSrc;
      else if (result === 'laughing') imgSrc = xiaoJiaoSrc;
      else imgSrc = yinJiaoSrc;
      return '<img src="' + imgSrc + '" class="w-24 h-auto sm:w-32 shadow-sm rounded-full bg-transparent mx-auto" alt="' + result + '" />';
    }

    function renderText(result) {
      if (result === 'holy') return { text: labels.holy, color: 'text-red-600', meaning: labels.holyMeaning };
      if (result === 'laughing') return { text: labels.laughing, color: 'text-green-600', meaning: labels.laughingMeaning };
      return { text: labels.angry, color: 'text-gray-600', meaning: labels.angryMeaning };
    }

    // ===== Section 1: Standalone Moon Blocks =====
    btnZhibei.addEventListener('click', function () {
      btnZhibei.disabled = true;
      resultText.style.opacity = '0';
      meaningText.textContent = labels.throwing;
      resultArea.innerHTML = '<div class="animate-spin w-10 h-10 border-4 border-red-200 border-t-red-600 rounded-full"></div>';

      setTimeout(function () {
        var result = getZhibeiResult();
        var info = renderText(result);
        resultArea.innerHTML = renderBlocks(result);
        resultText.textContent = info.text;
        resultText.className = 'zhibei-text absolute bottom-2 left-0 right-0 text-center font-bold text-xl transition-opacity duration-300 ' + info.color;
        resultText.style.opacity = '1';
        meaningText.textContent = info.meaning;
        btnZhibei.disabled = false;
      }, 800);
    });

    // ===== Section 2: Fortune Sticks (unified flow) =====
    // Flow: Draw stick → auto confirm with moon blocks → show result
    btnDraw.addEventListener('click', function () {
      btnDraw.classList.add('hidden');
      containerView.classList.add('animate-shake');

      setTimeout(function () {
        containerView.classList.remove('animate-shake');
        containerView.classList.add('hidden');

        var num = Math.floor(Math.random() * 60) + 1;
        currentStick = num;
        stickNumberEl.textContent = labels.stickPrefix + ' ' + num + ' ' + labels.stickSuffix;

        stickView.classList.remove('hidden');
        stickView.classList.add('flex');
        qianshiControls.classList.add('hidden');

        // Auto-cast moon blocks after showing the stick number
        confirmBlockArea.classList.add('hidden');
        setTimeout(function () {
          autoConfirmWithBlocks();
        }, 1200);
      }, 1500);
    });

    function autoConfirmWithBlocks() {
      // Show spinning indicator
      confirmBlockArea.classList.remove('hidden');
      confirmBlockImg.innerHTML = '<div class="animate-spin w-8 h-8 border-4 border-red-200 border-t-red-600 rounded-full mx-auto"></div>';
      confirmBlockText.textContent = labels.confirmingBlock;
      confirmBlockText.className = 'confirm-block-text text-sm text-gray-500 mb-1';

      setTimeout(function () {
        var result = getZhibeiResult();
        var info = renderText(result);

        confirmBlockImg.innerHTML = renderBlocks(result);
        confirmBlockText.textContent = info.text;
        confirmBlockText.className = 'confirm-block-text text-lg font-bold mb-1 ' + info.color;

        if (result === 'holy') {
          // Success! Show confirmed indicator after brief pause
          setTimeout(function () {
            stickView.classList.add('hidden');
            stickView.classList.remove('flex');
            confirmBlockArea.classList.add('hidden');
            confirmedView.classList.remove('hidden');
            confirmedView.classList.add('flex');

            // Dispatch fortune-confirmed event
            var dataIndex = (currentStick - 1) % fortuneData.length;
            var fortune = fortuneData[dataIndex];
            document.dispatchEvent(new CustomEvent('fortune-confirmed', {
              detail: { stickNumber: currentStick, fortune: fortune }
            }));

            // Reset after brief delay
            setTimeout(function () { resetQianshi(); }, 1500);
          }, 1000);
        } else {
          // Failed — show fail view after brief pause
          setTimeout(function () {
            stickView.classList.add('hidden');
            stickView.classList.remove('flex');
            confirmBlockArea.classList.add('hidden');
            failView.classList.remove('hidden');
            failView.classList.add('flex');
            failBlocks.innerHTML = renderBlocks(result);
            failText.textContent = info.text;
            failText.className = 'qianshi-fail-text text-xl font-bold mb-2 ' + info.color;
          }, 1000);
        }
      }, 800);
    }

    function resetQianshi() {
      stickView.classList.add('hidden');
      stickView.classList.remove('flex');
      failView.classList.add('hidden');
      failView.classList.remove('flex');
      confirmedView.classList.add('hidden');
      confirmedView.classList.remove('flex');
      confirmBlockArea.classList.add('hidden');
      containerView.classList.remove('hidden');
      btnDraw.classList.remove('hidden');
      qianshiControls.classList.remove('hidden');
      currentStick = null;
    }

    btnDrawAgain.addEventListener('click', resetQianshi);
  })();
</script>
