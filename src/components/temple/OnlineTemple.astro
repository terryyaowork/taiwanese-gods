const labels = allLabels[lang] || allLabels['zh-TW'];
const names = allNames[lang] || allNames['zh-TW'];
const prefix = lang === 'zh-TW' ? '' : `/${lang}`;
const fortuneHref = `${prefix}/fortune?god=${GOD_ID}&from=temple`;
const templesHref = `${prefix}/temples?from=temple`;
const sitOptions = [1, 3, 5];

const stations = [
  { id: 'burner', label: labels.navBurner },
  { id: 'hall', label: labels.navHall },
];

// 宋體只載入這一頁用到的標題字（Google Fonts text 子集），檔案很小
const serifText = [
  labels.pageTitle,
  labels.seal,
  '天',
  labels.bow1,
  labels.bow2,
  labels.bow3,
  labels.inhale,
  labels.exhale,
  labels.aboutTitle,
  labels.tipKeeper,
  '玉皇殿',
  // 分享圖卡用的字
  labels.cardLead,
  ...names,
  labels.cardNumbered,
  labels.cardIncense,
  labels.cardPalms,
  '0123456789,',
].join('');
const serifHref = `https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&display=swap&text=${encodeURIComponent(
  [...new Set(serifText)].join('')
)}`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={serifHref} />

<div
  id="online-temple"
  class="online-temple"
  data-lang={lang}
  data-labels={JSON.stringify(labels)}
  data-names={JSON.stringify(names)}
  data-path={`${prefix}/online-temple`}
>
  <div class="temple-stage">
    <div id="stage-sky" class="stage-sky" aria-hidden="true"></div>
    <div class="stage-grain" aria-hidden="true"></div>

    <!-- 固定在畫面上的：標題印章、人數 -->
    <div class="stage-hud">
      <div>
        <h1 class="hud-title">{labels.pageTitle}<span class="hud-seal">{labels.seal}</span></h1>
        <p id="hud-name" class="hud-name"></p>
      </div>
      <p id="hud-count" class="hud-count" aria-live="polite"></p>
    </div>
    <p id="stage-pop" class="stage-pop" aria-live="polite"></p>

    <div id="stage-track" class="stage-track" tabindex="0">
      <!-- ① 天公爐 -->
      <section class="station" id="station-burner" data-station="burner" aria-label={labels.navBurner}>
        <svg viewBox="0 0 400 420" class="station-art" id="burner-art" aria-hidden="true">
          <defs>
            <radialGradient id="crowd-light" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#f0a648" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="#f0a648" stop-opacity="0"></stop>
            </radialGradient>
            <linearGradient id="pillar" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#f3e9d4" stop-opacity="0.5"></stop>
              <stop offset="1" stop-color="#f3e9d4" stop-opacity="0"></stop>
            </linearGradient>
            <radialGradient id="halo" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#d4a24c" stop-opacity="0.22"></stop>
              <stop offset="1" stop-color="#d4a24c" stop-opacity="0"></stop>
            </radialGradient>
            <radialGradient id="lantern-light" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#f0a648" stop-opacity="0.3"></stop>
              <stop offset="1" stop-color="#f0a648" stop-opacity="0"></stop>
            </radialGradient>
            <radialGradient id="lantern-body" cx="0.45" cy="0.4" r="0.6">
              <stop offset="0" stop-color="#e0623f"></stop>
              <stop offset="1" stop-color="#7d2418"></stop>
            </radialGradient>
            <!-- 紅燈籠：原點在吊繩下端，各站共用 -->
            <symbol id="lantern" overflow="visible">
              <circle cx="0" cy="32" r="46" fill="url(#lantern-light)"></circle>
              <rect x="-9" y="0" width="18" height="6" fill="#d4a24c"></rect>
              <ellipse cx="0" cy="33" rx="22" ry="28" fill="url(#lantern-body)"></ellipse>
              <g fill="none" stroke="#e9cf98" stroke-opacity="0.45" stroke-width="0.8">
                <path d="M0 5 V61 M-11 7 Q-21 33 -11 59 M11 7 Q21 33 11 59"></path>
              </g>
              <rect x="-9" y="60" width="18" height="6" fill="#d4a24c"></rect>
              <g stroke="#c2412d" stroke-width="1.2" stroke-linecap="round">
                <path d="M-3 66 V86 M0 66 V90 M3 66 V86"></path>
              </g>
            </symbol>
            <linearGradient id="gold-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#e2b766"></stop>
              <stop offset="1" stop-color="#a87a2c"></stop>
            </linearGradient>
            <linearGradient id="flame" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#c2412d"></stop>
              <stop offset="0.55" stop-color="#f0a648"></stop>
              <stop offset="1" stop-color="#fff1c8"></stop>
            </linearGradient>
            <filter id="glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
            </filter>
            <pattern id="meander" width="12" height="8" patternUnits="userSpaceOnUse">
              <path d="M1 7 V1 H9 V5 H5 V3" fill="none" stroke="#d4a24c" stroke-width="0.8"></path>
            </pattern>
            <mask id="bowl-cut">
              <rect width="400" height="420" fill="white"></rect>
              <text x="200" y="262" text-anchor="middle" class="serif-900" font-size="40" fill="black">天</text>
              <g fill="none" stroke="black" stroke-width="2.4" stroke-linecap="round">
                <path d="M146 232 a7 7 0 1 1 10 7 h18 a5 5 0 1 0 -4 -8"></path>
                <path d="M254 232 a7 7 0 1 0 -10 7 h-18 a5 5 0 1 1 4 -8"></path>
                <path d="M156 258 a5 5 0 1 1 8 4 h12"></path>
                <path d="M244 258 a5 5 0 1 0 -8 4 h-12"></path>
              </g>
            </mask>
          </defs>
          <!-- 鏡頭拉遠才看得到的：整座廟、廟外的街 -->
          <g id="scene-far" class="scale-layer" opacity="0" fill="none" stroke="#d4a24c">
            <g stroke-opacity="0.22" stroke-width="1">
              <rect x="-2400" y="-1700" width="1900" height="2500"></rect>
              <rect x="900" y="-1700" width="1900" height="2500"></rect>
              <rect x="-2400" y="1500" width="1900" height="1500"></rect>
              <rect x="-200" y="1500" width="800" height="1500"></rect>
              <rect x="900" y="1500" width="1900" height="1500"></rect>
            </g>
            <g stroke-width="1.2">
              <path d="M-220 -130 Q 200 -180 620 -130 M-220 -130 q -30 -6 -46 -40 M620 -130 q 30 -6 46 -40"></path>
              <path d="M-290 -40 Q 200 -96 690 -40"></path>
              <path d="M-200 -40 V 120 M0 -40 V 120 M400 -40 V 120 M600 -40 V 120 M-300 120 H 700"></path>
              <path d="M-300 120 V 900 H 120 M280 900 H 700 V 120"></path>
              <path d="M60 860 Q 200 826 340 860 M120 852 V 960 M280 852 V 960"></path>
              <path d="M-2600 1000 H 120 M280 1000 H 3000 M-2600 1420 H 3000" stroke-opacity="0.5"></path>
            </g>
          </g>
          <ellipse
            id="crowd-glow"
            class="scale-layer"
            cx="200"
            cy="600"
            rx="400"
            ry="300"
            fill="url(#crowd-light)"
            opacity="0"></ellipse>
          <g id="smoke-pillar" class="scale-layer" opacity="0" fill="none" stroke="url(#pillar)" stroke-linecap="round">
            <path id="pillar-wide" stroke-opacity="0.35"></path>
            <path id="pillar-core" stroke-opacity="0.6"></path>
          </g>
          <!-- 廟埕上方的紅燈籠 -->
          <g stroke="#d4a24c" stroke-opacity="0.5" stroke-width="0.8">
            <path d="M62 -20 V 30 M338 -20 V 30"></path>
          </g>
          <g class="lantern-sway"><use href="#lantern" x="62" y="30"></use></g>
          <g class="lantern-sway lantern-sway-late"><use href="#lantern" x="338" y="30"></use></g>
          <circle cx="200" cy="230" r="150" fill="url(#halo)"></circle>
          <g id="burner-smoke"></g>
          <g id="burner-sticks"></g>
          <g>
            <path
              d="M128 214 C 104 210, 100 236, 118 240 C 128 242, 130 232, 122 230 M272 214 C 296 210, 300 236, 282 240 C 272 242, 270 232, 278 230"
