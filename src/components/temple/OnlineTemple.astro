// 香客名：第一次來時隨機給一個，存在自己的瀏覽器。用台灣的花木、景色和小吃，各語言照同一個順序翻譯
const allNames: Record<string, string[]> = {
  'zh-TW': [
    '晚風',
    '山雨',
    '桐花',
    '月桃',
    '相思',
    '茶香',
