---
import Layout from '~/layouts/PageLayout.astro';
import Divination from '~/components/common/Divination.astro';

const { god } = Astro.props;

const lang = 'zh-TW';

const labels = {
  'zh-TW': {
    aliases: '聖號別稱',
    domain: '職掌神職',
    description: '神明簡介',
    story: '傳說典故',
    temples: '靈驗宮廟',
    worship: '參拜禮儀',
    festivals: '聖誕千秋',
    back: '← 返回列表',
  },
};

// Image handling logic moved here or kept in parent?
// Parent passes the full god object, so we might need to resolve image here if passed as string
// But [id].astro resolves it. Let's assume parent resolves it or passes resolved URL.
// Actually, [id].astro does the dynamic import and resolution.
// Let's expect `god` to have `imageSrc` property added by parent, OR we pass `imageSrc` as prop.
// For now, let's pass `imageSrc` as a separate prop to keep it clean.

const { imageSrc } = Astro.props;

const metadata = {
  title: god.name[lang],
  description: god.description[lang].substring(0, 150) + '...',
  openGraph: {
    images: [
      {
        url: imageSrc,
        width: 1200,
        height: 630,
        alt: god.name[lang],
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <div class="main-container bg-paper-texture min-h-screen pb-12">
    <!-- Hero Section with Image & Title -->
    <div class="relative w-full h-[40vh] md:h-[50vh] overflow-hidden">
      <div class="absolute inset-0 bg-black/60 z-10"></div>
      <img
        src={imageSrc}
        alt={god.name[lang]}
        class="absolute inset-0 w-full h-full object-cover blur-sm scale-110 opacity-50"
      />
      <div class="relative z-20 h-full max-w-5xl mx-auto px-4 flex flex-col justify-end pb-12">
        <span
          class="inline-block px-3 py-1 bg-red-800 text-gold-100 text-sm font-bold tracking-widest rounded-sm mb-2 w-fit border border-gold-300/30 backdrop-blur-sm"
        >
          {god.domain[lang]}
        </span>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-white mb-2 drop-shadow-lg tracking-wide">
          {god.name[lang]}
        </h1>
        <p class="text-white/80 text-lg md:text-xl font-light tracking-wider">
          {god.aliases[lang]?.join('  |  ')}
        </p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-8 relative z-30">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Content: Description & Story -->
        <div class="lg:col-span-2 space-y-8 bg-white/95 p-8 rounded-lg shadow-xl border-t-4 border-red-800">
          <section>
            <h2 class="section-title">{labels[lang].description}</h2>
            <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed font-serif">
              {god.description[lang].split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </section>

          <section>
            <h2 class="section-title">{labels[lang].story}</h2>
            <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
              {god.story[lang].split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </section>

          {
            god.worship && god.worship[lang] && (
              <section>
                <h2 class="section-title">{labels[lang].worship}</h2>
                <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
                  {god.worship[lang].split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
                </div>
              </section>
            )
          }

          {
            god.festivals && god.festivals[lang] && (
              <section>
                <h2 class="section-title">{labels[lang].festivals}</h2>
                <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
                  {god.festivals[lang].split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
                </div>
              </section>
            )
          }

          <section>
            <h2 class="section-title">{labels[lang].temples}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {
                god.temples.map((t) => (
                  <a href={t.url} target="_blank" rel="noopener" class="block group">
                    <div class="bg-gray-50 hover:bg-red-50 border border-gray-200 hover:border-red-200 p-4 rounded-md transition-all h-full">
                      <h4 class="font-bold text-lg text-primary-800 group-hover:text-red-700 mb-1 flex items-center">
                        <span class="mr-2">⛩️</span> {t.name[lang]}
                      </h4>
                      <p class="text-sm text-gray-500 mb-2">{t.location}</p>
                      {t.deityStory && t.deityStory[lang] && (
                        <p class="text-sm text-gray-600 line-clamp-2 italic">{t.deityStory[lang]}</p>
                      )}
                    </div>
                  </a>
                ))
              }
            </div>
          </section>
        </div>

        <!-- Right Sidebar: Image & Divination -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Main Image Card -->
          <div class="bg-white p-2 rounded-lg shadow-lg border-2 border-gold-200">
            <img src={imageSrc} alt={god.name[lang]} class="w-full h-auto object-cover rounded-md" />
            <div class="text-center py-3">
              <p class="font-serif font-bold text-xl text-primary-900">{god.name[lang]}</p>
              <p class="text-sm text-gray-500">{god.domain[lang]}</p>
            </div>
          </div>

          <!-- Divination Component -->
          <Divination />

          <div class="mt-8 text-center">
            <a
              href={`/gods/${god.category || 'taoism'}`}
              class="inline-flex items-center text-gray-600 hover:text-red-700 font-medium transition-colors"
            >
              {labels[lang].back}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Custom Fonts & Colors */
  .text-gold-100 {
    color: #fbf5e6;
  }
  .text-gold-300 {
    color: #d4af37;
  }
  .border-gold-200 {
    border-color: #e5c15d;
  }
  .bg-paper-texture {
    background-color: #fcfbf7;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d8c8b0' fill-opacity='0.15'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  .section-title {
    @apply text-2xl font-bold mb-6 pb-2 border-b-2 border-red-100 text-red-900 inline-block font-serif;
    position: relative;
  }
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background-color: #b91c1c;
  }
</style>
