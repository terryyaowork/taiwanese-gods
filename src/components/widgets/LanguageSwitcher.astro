---
const languages = [
  { code: 'zh-TW', label: '繁體中文', prefix: '' },
  { code: 'en', label: 'English', prefix: '/en' },
  { code: 'ja', label: '日本語', prefix: '/ja' },
];

const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
const isJa = currentPath.startsWith('/ja');
const currentLangCode = isEn ? 'en' : isJa ? 'ja' : 'zh-TW';
const currentLangLabel = languages.find((l) => l.code === currentLangCode)?.label || '繁體中文';

// 偵測是否為神明細節頁
const detailMatch = currentPath.match(/^\/(en|ja|zh-TW)?\/?gods\/(taoism|buddhism|folk)\/([^/]+)$/);
const isDetailPage = !!detailMatch;
const godCategory = isDetailPage ? detailMatch[2] : null;
const godId = isDetailPage ? detailMatch[3] : null;

function getSwitchPath(lang: { code: string; label: string; prefix: string }) {
  if (isDetailPage && godId && godCategory) {
    // 細節頁切換語言時保留 id
    if (lang.code === 'zh-TW') {
      return `/gods/${godCategory}/${godId}`;
    } else {
      return `/${lang.code}/gods/${godCategory}/${godId}`;
    }
  } else {
    // 其他頁維持原本邏輯
    let cleanPath = currentPath.replace(/^\/(en|ja)/, '') || '/';

    // Ensure cleanPath starts with /
    if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;

    if (lang.code === 'zh-TW') {
      return cleanPath;
    } else {
      return `/${lang.code}${cleanPath === '/' ? '' : cleanPath}`;
    }
  }
}
---

<!-- Mobile: inline language links (shown in hamburger menu) -->
<div class="flex lg:hidden items-center gap-2 ml-4">
  {
    languages.map((lang) => (
      <a
        href={getSwitchPath(lang)}
        class={`px-3 py-1.5 rounded-full text-sm font-medium transition-colors lang-switch-link ${
          currentLangCode === lang.code
            ? 'bg-red-800 text-white'
            : 'border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-red-900/20'
        }`}
      >
        {lang.label}
      </a>
    ))
  }
</div>

<!-- Desktop: dropdown language switcher -->
<div class="relative ml-4 z-50 hidden lg:block" id="lang-switcher-desktop">
  <button
    type="button"
    class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-300 dark:border-gray-600 bg-red-900/10 dark:bg-gray-700/50 hover:bg-red-900/20 dark:hover:bg-gray-600/50 text-primary-900 dark:text-gray-200 transition-colors text-sm font-medium focus:outline-none"
    aria-label="Select Language"
    id="lang-menu-button"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{currentLangLabel}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4 opacity-70 transition-transform"
      id="lang-chevron"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
        clip-rule="evenodd"></path>
    </svg>
  </button>

  <div
    class="absolute right-0 mt-2 w-32 bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-md shadow-lg border border-gray-200 dark:border-gray-600 opacity-0 invisible transition-all duration-200 transform origin-top-right scale-95"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="lang-menu-button"
    id="lang-dropdown"
  >
    <div class="py-1" role="none">
      {
        languages.map((lang) => (
          <a
            href={getSwitchPath(lang)}
            class={`block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-red-800 dark:hover:text-red-400 lang-switch-link ${currentLangCode === lang.code ? 'font-bold bg-gray-100 dark:bg-gray-700 text-red-900 dark:text-red-400' : ''}`}
            role="menuitem"
          >
            {lang.label}
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Desktop dropdown toggle on click
    const btn = document.getElementById('lang-menu-button');
    const dropdown = document.getElementById('lang-dropdown');
    const chevron = document.getElementById('lang-chevron');

    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !dropdown.classList.contains('invisible');
        if (isOpen) {
          dropdown.classList.add('invisible', 'opacity-0', 'scale-95');
          dropdown.classList.remove('opacity-100', 'scale-100');
          chevron?.classList.remove('rotate-180');
        } else {
          dropdown.classList.remove('invisible', 'opacity-0', 'scale-95');
          dropdown.classList.add('opacity-100', 'scale-100');
          chevron?.classList.add('rotate-180');
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', () => {
        dropdown.classList.add('invisible', 'opacity-0', 'scale-95');
        dropdown.classList.remove('opacity-100', 'scale-100');
        chevron?.classList.remove('rotate-180');
      });
    }

    // Save selected lang to localStorage
    const links = document.querySelectorAll('.lang-switch-link');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const anchor = target.closest('a');
        if (!anchor) return;

        const href = anchor.getAttribute('href') || '/';
        let lang = 'zh-TW';
        if (href.startsWith('/en')) lang = 'en';
        if (href.startsWith('/ja')) lang = 'ja';
        localStorage.setItem('selectedLang', lang);
      });
    });
  });
</script>
