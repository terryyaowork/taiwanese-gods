---
import Layout from '~/layouts/PageLayout.astro';
import north from '~/data/zh-TW/temples-north.json';
import central from '~/data/zh-TW/temples-central.json';
import south from '~/data/zh-TW/temples-south.json';
import east from '~/data/zh-TW/temples-east.json';

const regions = [
  { slug: 'north', name: '北部廟宇', temples: north },
  { slug: 'central', name: '中部廟宇', temples: central },
  { slug: 'south', name: '南部廟宇', temples: south },
  { slug: 'east', name: '東部與離島', temples: east },
];

const total = regions.reduce((n, r) => n + r.temples.length, 0);

const metadata = {
  title: `台灣廟宇總覽：${total} 間廟宇的主祀神明與參拜資訊`,
  ignoreTitleTemplate: true,
  description: `北中南東與離島，${total} 間值得走一趟的台灣廟宇，含主祀神明、地址與參拜重點。`,
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        台灣廟宇總覽
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        台灣的廟宇密度是世界少見的。這裡收錄 {total} 間，依地區分成四組，每一間都附主祀神明與參拜重點。
      </p>
    </div>

    <div class="space-y-10">
      {
        regions.map((region) => (
          <section class="bg-white/90 dark:bg-gray-800/90 rounded-lg border border-gold-200 shadow-lg p-6">
            <div class="flex flex-wrap items-baseline gap-3 mb-4">
              <a
                href={`/temples/${region.slug}`}
                class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 hover:text-red-700 transition"
              >
                {region.name}
              </a>
              <span class="text-sm text-gray-500 dark:text-gray-400">{region.temples.length} 間</span>
            </div>
            <ul class="flex flex-wrap gap-x-4 gap-y-2">
              {region.temples.map((temple) => (
                <li>
                  <a
                    href={`/temples/${temple.id}`}
                    class="text-gray-700 dark:text-gray-300 hover:text-red-700 dark:hover:text-red-300 underline decoration-gold-300 underline-offset-4 transition"
                  >
                    {temple.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
