---
import Layout from '~/layouts/PageLayout.astro';
import temples from '~/data/zh-TW/temples-central.json';
const metadata = {
  title: '中部廟宇巡禮',
  description: '探索台灣中部代表性廟宇，包含大甲鎮瀾宮、鹿港天后宮、北港朝天宮等知名寺廟的歷史與文化特色。',
};
// Dynamically import all temple images from src/assets
const templeImages = import.meta.glob('/src/assets/images/temples/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getTempleImage = (imagePath) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();

  const foundKey = Object.keys(templeImages).find((key) => {
    return key.endsWith('/' + filename);
  });

  if (foundKey) {
    return templeImages[foundKey];
  }
  return imagePath;
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        中部廟宇巡禮
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        介紹台灣中部代表性廟宇，包含主祀神明、歷史與文化特色。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        temples.map((temple) => {
          const image = getTempleImage(temple.images?.[0]);
          const imageSrc = image && typeof image === 'object' ? image.src : image;
          return (
            <a
              href={`/temples/${temple.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              {imageSrc && (
                <div class="relative h-48 overflow-hidden">
                  <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                  <img
                    src={imageSrc}
                    alt={temple.name}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {temple.name}
                </h2>
                <div class="text-sm font-medium text-gold-300 mb-3 tracking-wider uppercase">{temple.location}</div>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {temple.description}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>
