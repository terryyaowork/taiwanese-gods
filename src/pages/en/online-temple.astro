---
import Layout from '~/layouts/PageLayout.astro';
import TempleCourtyard from '~/components/temple/OnlineTemple.astro';

const metadata = {
  title: 'Online Temple: Light Incense at the Tiangong Censer and Sit Quietly | Taiwanese Deities',
  description:
    'When you cannot go to a temple, light a stick of incense at the Tiangong censer here and sit quietly for a few minutes. Follow Taiwanese temple etiquette: hold the incense and pray silently, bow three times, then place the incense. Free, no sign-in.',
  // 分享預覽圖：從頁面畫面截出來（天公爐＋標題），三語各一張
  openGraph: {
    images: [{ url: '~/assets/images/temple/og-online-temple-en.png', width: 1200, height: 628, alt: 'Online Temple' }],
  },
};
---

<Layout metadata={metadata} noAds>
  <TempleCourtyard lang="en" />
</Layout>
