---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import templesNorth from '~/data/en/temples-north.json';
import templesCentral from '~/data/en/temples-central.json';
import templesSouth from '~/data/en/temples-south.json';
import templesEast from '~/data/en/temples-east.json';
import taoistGods from '~/data/en/taoist-gods.json';
import buddhistGods from '~/data/en/buddhist-gods.json';
import folkGods from '~/data/en/folk-gods.json';

export async function getStaticPaths() {
  const temples = [...templesNorth, ...templesCentral, ...templesSouth, ...templesEast];
  return temples.map((temple) => ({
    params: { id: temple.id },
    props: { temple },
  }));
}

const { temple } = Astro.props;

const godCategoryMap = new Map();
// eslint-disable-next-line @typescript-eslint/no-explicit-any
([...taoistGods, ...buddhistGods, ...folkGods] as any[]).forEach((god: any) => {
  godCategoryMap.set(
    god.id,
    god.category || (buddhistGods.includes(god) ? 'buddhism' : folkGods.includes(god) ? 'folk' : 'taoism')
  );
});

const getGodLink = (godId: string) => {
  if (!godCategoryMap.has(godId)) return null;
  const category = godCategoryMap.get(godId);
  if (category) return `/en/gods/${category}/${godId}`;
  if (buddhistGods.some((g) => g.id === godId)) return `/en/gods/buddhism/${godId}`;
  if (folkGods.some((g) => g.id === godId)) return `/en/gods/folk/${godId}`;
  return `/en/gods/taoism/${godId}`;
};

if (!temple) {
  throw new Error('Temple not found');
}

const templeImages = import.meta.glob('/src/assets/images/temples/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getTempleImage = (imagePath: string | undefined) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(templeImages).find((key) => key.endsWith('/' + (filename || '')));
  if (foundKey) return templeImages[foundKey];
  return imagePath;
};

const mainImage = getTempleImage(temple.images?.[0]);
// @ts-expect-error -- accessing .src on untyped image object
const mainImageSrc = mainImage && typeof mainImage === 'object' ? mainImage.src : mainImage;

let backLink = '/en/temples/north';
if (templesCentral.some((t) => t.id === temple.id)) backLink = '/en/temples/central';
else if (templesSouth.some((t) => t.id === temple.id)) backLink = '/en/temples/south';
else if (templesEast.some((t) => t.id === temple.id)) backLink = '/en/temples/east';

const regionLabels: Record<string, string> = {
  '/en/temples/north': 'North Taiwan',
  '/en/temples/central': 'Central Taiwan',
  '/en/temples/south': 'South Taiwan',
  '/en/temples/east': 'East Taiwan & Islands',
};

const metadata = {
  title: `${temple.name} — Taiwanese Gods`,
  ignoreTitleTemplate: true,
  description: temple.description.substring(0, 150) + '...',
  openGraph: {
    images: mainImageSrc ? [{ url: mainImageSrc, width: 1200, height: 630, alt: temple.name }] : [],
  },
};

const siteUrl = 'https://www.taiwanese-gods.org';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HinduTemple',
  name: temple.name,
  description: temple.description.substring(0, 300),
  address: {
    '@type': 'PostalAddress',
    streetAddress: temple.address,
    addressRegion: temple.location,
    addressCountry: 'TW',
  },
  url: `${siteUrl}/en/temples/${temple.id}`,
  inLanguage: 'en',
  ...(mainImageSrc ? { image: mainImageSrc } : {}),
  ...(temple.googleMap ? { hasMap: temple.googleMap } : {}),
};
---

<Layout metadata={metadata}>
  <JsonLd data={jsonLd} />
  <div class="temple-page bg-paper-texture min-h-screen pb-12">
    <!-- Hero Section -->
    <div class="relative w-full h-[30vh] sm:h-[40vh] md:h-[50vh] overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/60 to-black/80 z-10"></div>
      {
        mainImageSrc ? (
          <img
            src={mainImageSrc}
            alt={temple.name}
            class="absolute inset-0 w-full h-full object-cover blur-sm scale-110 opacity-60"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-red-900 via-red-800 to-amber-900" />
        )
      }
      <div class="relative z-20 h-full max-w-5xl mx-auto px-4 flex flex-col justify-end pb-6 sm:pb-10">
        <div class="flex items-center gap-2 mb-2 sm:mb-3">
          <a href={backLink} class="text-white/60 hover:text-white text-sm transition-colors">
            {regionLabels[backLink]}
          </a>
          <span class="text-white/40">›</span>
          <span class="text-white/80 text-sm">{temple.name}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-white mb-2 drop-shadow-lg tracking-wide">
          {temple.name}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-white/70 text-sm">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            {temple.location}
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path></svg
            >
            {temple.address}
          </span>
        </div>
      </div>
    </div>

    <!-- Content Area -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-4 sm:-mt-8 relative z-30">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        <!-- Left: Main Content -->
        <div
          class="lg:col-span-2 space-y-6 sm:space-y-8 bg-white/95 dark:bg-gray-800/95 p-4 sm:p-6 md:p-8 rounded-lg shadow-xl border-t-4 border-red-800"
        >
          <!-- TOC -->
          <nav
            class="bg-red-50/60 dark:bg-red-900/20 border border-red-100 dark:border-red-800/50 rounded-lg p-3 sm:p-5"
          >
            <h3 class="font-serif font-bold text-red-900 dark:text-red-300 mb-3 text-sm tracking-widest uppercase">
              Contents
            </h3>
            <ol class="space-y-1.5">
              <li>
                <a
                  href="#deities"
                  class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-red-700 dark:hover:text-red-400 transition-colors text-[15px]"
                  ><span class="text-red-300 dark:text-red-600 text-xs font-mono">01</span> Main Deities</a
                >
              </li>
              <li>
                <a
                  href="#description"
                  class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-red-700 dark:hover:text-red-400 transition-colors text-[15px]"
                  ><span class="text-red-300 dark:text-red-600 text-xs font-mono">02</span> About</a
                >
              </li>
              <li>
                <a
                  href="#history"
                  class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-red-700 dark:hover:text-red-400 transition-colors text-[15px]"
                  ><span class="text-red-300 dark:text-red-600 text-xs font-mono">03</span> History</a
                >
              </li>
            </ol>
          </nav>

          <!-- Main Deities -->
          <div id="deities" class="scroll-mt-6">
            <h2 class="section-title">Main Deities</h2>
            <div class="flex flex-wrap gap-3 mt-4">
              {
                temple.mainDeities.map((d) => {
                  const godLink = getGodLink(d.id);
                  return godLink ? (
                    <a
                      href={godLink}
                      class="group flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-red-50 to-amber-50 dark:from-red-900/30 dark:to-amber-900/30 border border-red-200 dark:border-red-800 rounded-full text-red-900 dark:text-red-300 font-bold shadow-sm hover:shadow-md hover:from-red-100 hover:to-amber-100 dark:hover:from-red-900/50 dark:hover:to-amber-900/50 transition-all transform hover:-translate-y-0.5"
                    >
                      <span>{d.name}</span>
                      <span class="text-xs text-red-400 opacity-0 group-hover:opacity-100 transition-opacity">
                        → Details
                      </span>
                    </a>
                  ) : (
                    <span class="flex items-center gap-2 px-5 py-2.5 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-full text-gray-700 dark:text-gray-300 font-bold">
                      <span>{d.name}</span>
                    </span>
                  );
                })
              }
            </div>
          </div>

          <!-- Description -->
          <div id="description" class="scroll-mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
            <h2 class="section-title">About</h2>
            <div class="prose prose-lg max-w-none text-gray-700 dark:text-gray-300 leading-relaxed font-serif mt-4">
              {temple.description.split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </div>

          <!-- History -->
          <div id="history" class="scroll-mt-6 pt-6 border-t border-gray-100 dark:border-gray-700">
            <h2 class="section-title">History</h2>
            <div class="prose prose-lg max-w-none text-gray-700 dark:text-gray-300 leading-relaxed mt-4">
              {temple.history.split('\n').map((line) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </div>
        </div>

        <!-- Right: Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <!-- Image Card -->
          {
            mainImageSrc && (
              <div class="bg-white dark:bg-gray-800 p-2 rounded-lg shadow-lg border-2 border-gold-200">
                <img src={mainImageSrc} alt={temple.name} class="w-full h-auto object-cover rounded-md" />
                <div class="text-center py-3">
                  <p class="font-serif font-bold text-xl text-primary-900 dark:text-gray-100">{temple.name}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{temple.location}</p>
                </div>
              </div>
            )
          }

          <!-- Info Card -->
          <div class="bg-white/95 dark:bg-gray-800/95 p-6 rounded-lg shadow-lg">
            <h3
              class="font-bold text-lg text-red-900 dark:text-red-300 mb-4 pb-2 border-b border-red-100 dark:border-red-900"
            >
              Visitor Info
            </h3>
            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <span class="text-red-600 mt-0.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
                  >
                </span>
                <div>
                  <p class="font-bold text-gray-800 dark:text-gray-200">Address</p>
                  <p class="text-gray-600 dark:text-gray-400">{temple.address}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-red-600 mt-0.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path></svg
                  >
                </span>
                <div>
                  <p class="font-bold text-gray-800 dark:text-gray-200">Region</p>
                  <p class="text-gray-600 dark:text-gray-400">{temple.location}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-3">
            {
              temple.url && (
                <a
                  href={temple.url}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center justify-center gap-2 w-full px-6 py-4 bg-red-800 text-white hover:bg-red-900 rounded-lg transition-all duration-300 font-bold shadow-md hover:shadow-lg group"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                    />
                  </svg>
                  <span>Official Website</span>
                  <span class="inline-block transform group-hover:translate-x-1 transition-transform">→</span>
                </a>
              )
            }
            {
              temple.googleMap && (
                <a
                  href={temple.googleMap}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center justify-center gap-2 w-full px-6 py-4 bg-white dark:bg-gray-800 border-2 border-amber-600 text-amber-700 hover:bg-amber-600 hover:text-white rounded-lg transition-all duration-300 font-bold shadow-sm hover:shadow-lg"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                    />
                  </svg>
                  <span>Google Maps</span>
                </a>
              )
            }
          </div>

          <!-- Back Link -->
          <div class="mt-4 text-center">
            <a
              href={backLink}
              class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-red-700 font-medium transition-colors"
            >
              ← Back to Temple List
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  .section-title {
    @apply text-2xl font-bold pb-2 border-b-2 border-red-100 text-red-900 inline-block font-serif;
    position: relative;
  }
  .section-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background-color: #b91c1c;
  }
</style>
