---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Contact — Taiwanese Gods', ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide">Contact Us</h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        Thank you for your interest in Taiwanese religious culture! Whether you have suggestions, wish to collaborate, or have questions, we'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <div class="bg-white/80 dark:bg-gray-800/80 p-8 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
        <h2 class="text-xl font-serif font-bold text-red-900 dark:text-red-300 mb-4">Email</h2>
        <p class="text-gray-700 dark:text-gray-300 mb-4">For any questions or suggestions, feel free to reach out via email. We'll respond as soon as possible.</p>
        <a href="mailto:taiwanese.gods@gmail.com" class="inline-flex items-center gap-2 text-red-700 dark:text-red-400 hover:underline font-medium text-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          taiwanese.gods@gmail.com
        </a>
      </div>

      <div class="bg-white/80 dark:bg-gray-800/80 p-8 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
        <h2 class="text-xl font-serif font-bold text-red-900 dark:text-red-300 mb-4">Response Time</h2>
        <p class="text-gray-700 dark:text-gray-300 mb-4">We typically respond within 1-3 business days. For urgent matters, please indicate so in your email subject line.</p>
        <p class="text-gray-500 dark:text-gray-400 text-sm italic">Please briefly describe your request so we can assist you more efficiently.</p>
      </div>
    </div>

    <div class="space-y-8">
      <h2 class="text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-6">How Can We Help?</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white/60 dark:bg-gray-800/60 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3">💡</div>
          <h3 class="font-bold text-gray-800 dark:text-gray-200 mb-2">Content Suggestions</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">Found an error, missing information, or want to recommend a new deity or temple for us to feature? Let us know!</p>
        </div>
        <div class="bg-white/60 dark:bg-gray-800/60 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3">🤝</div>
          <h3 class="font-bold text-gray-800 dark:text-gray-200 mb-2">Collaboration</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">Temple organizations, cultural institutions, travel agencies, or educational bodies interested in partnering with us are welcome to reach out.</p>
        </div>
        <div class="bg-white/60 dark:bg-gray-800/60 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3">📝</div>
          <h3 class="font-bold text-gray-800 dark:text-gray-200 mb-2">Content Licensing</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">If you'd like to use our content (text or images) for publications or other purposes, please contact us to discuss licensing.</p>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/en" class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium">
        Back to Home
      </a>
    </div>
  </div>
</Layout>
