---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import rituals from '~/data/en/culture-rituals.json';

export async function getStaticPaths() {
  return rituals.map((ritual) => ({
    params: { id: ritual.id },
  }));
}

const { id } = Astro.params;
const ritual = rituals.find((r) => r.id === id);
if (!ritual) {
  throw new Error('Ritual not found');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-rituals/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(cultureImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = cultureImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = ritual.images?.[0] ? getImage(ritual.images[0]) : null;
---

<CultureDetail
  item={ritual}
  imageSrc={imageSrc}
  category="rituals"
  categoryLabel="Worship Rituals"
  backLink="/en/culture/rituals"
  backLabel="← Back to Rituals"
  lang="en"
/>
