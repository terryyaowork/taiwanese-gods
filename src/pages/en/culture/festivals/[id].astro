---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import festivals from '~/data/en/culture-festivals.json';

export async function getStaticPaths() {
  return festivals.map((festival) => ({
    params: { id: festival.id },
  }));
}

const { id } = Astro.params;
const festival = festivals.find((f) => f.id === id);
if (!festival) {
  throw new Error('Festival not found');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-festivals/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(cultureImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = cultureImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = festival.images?.[0] ? getImage(festival.images[0]) : null;
---

<CultureDetail
  item={festival}
  imageSrc={imageSrc}
  category="festivals"
  categoryLabel="Festivals & Events"
  backLink="/en/culture/festivals"
  backLabel="← Back to Festivals"
  lang="en"
/>
