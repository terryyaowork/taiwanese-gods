---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import customs from '~/data/en/culture-customs.json';

export async function getStaticPaths() {
  return customs.map((item) => ({
    params: { id: item.id },
  }));
}

const { id } = Astro.params;
const item = customs.find((c) => c.id === id);
if (!item) {
  throw new Error('Custom not found');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-rituals/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(cultureImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = cultureImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = item.images?.[0] ? getImage(item.images[0]) : null;
---

<CultureDetail
  item={item}
  imageSrc={imageSrc}
  category="customs"
  categoryLabel="Folk Beliefs & Customs"
  backLink="/en/culture/customs"
  backLabel="← Back to Folk Beliefs"
  lang="en"
/>
