---
import Layout from '~/layouts/PageLayout.astro';
import stories from '~/data/en/god-stories.json';

export async function getStaticPaths() {
  return stories.map((story) => ({
    params: { id: story.id },
  }));
}

const { id } = Astro.params;
const story = stories.find((s) => s.id === id);
if (!story) {
  throw new Error('Story not found');
}
---

<Layout
  metadata={{
    title: `${story.title} — Taiwanese Gods`,
    ignoreTitleTemplate: true,
    description: story.content?.substring(0, 150) + '...',
  }}
>
  <div class="max-w-2xl mx-auto py-8">
    {story.images?.[0] && <img src={story.images[0]} alt={story.title} class="w-full object-cover rounded mb-6" />}
    <h1 class="text-3xl font-bold mb-2">{story.title}</h1>
    <div class="mb-2 text-gray-600">Main Deities: {story.mainDeities.map((d) => d.name).join(', ')}</div>
    <div class="mb-4 text-lg whitespace-pre-line">{story.content}</div>
    <a href="/en/gods/stories" class="text-blue-600 hover:underline">← Back to Deity Stories</a>
  </div>
</Layout>
