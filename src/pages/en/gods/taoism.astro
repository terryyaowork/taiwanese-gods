---
import Layout from '~/layouts/PageLayout.astro';
import gods from '~/data/taoist-gods.json';

const metadata = {
  title: 'Taoist Deities in Taiwan | Taiwanese Gods',
  description:
    'Explore common Taoist deities worshipped in Taiwan, including the Jade Emperor, Mazu, and Guan Di. Learn about their stories, domains, and major festivals.',
  openGraph: {
    images: [
      {
        url: gods[0]?.image || '/assets/images/gods/default.jpg',
        width: 1200,
        height: 630,
        alt: 'Taoist Deities Collection',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-4 text-gray-900">Taoist Deities in Taiwan</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Discover the rich pantheon of Taoist gods revered in Taiwan. Learn about their legends, roles, and the temples
        dedicated to them.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        gods.map((god) => (
          <a
            href={`/en/gods/taoism/${god.id}`}
            class="group block bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 transform hover:-translate-y-1"
          >
            <div class="relative h-64 overflow-hidden bg-gray-100">
              {god.image ? (
                <img
                  src={god.image}
                  alt={god.name.en}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="flex items-center justify-center h-full text-gray-400">No Image</div>
              )}
            </div>

            <div class="p-6">
              <h2 class="text-2xl font-bold mb-3 text-gray-800 group-hover:text-primary-600 transition-colors">
                {god.name.en}
              </h2>
              <p class="text-gray-600 line-clamp-3 leading-relaxed">{god.description.en}</p>
              <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                <span class="text-sm text-gray-500 font-medium">Read More →</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/en"
        class="inline-block px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors font-medium"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
