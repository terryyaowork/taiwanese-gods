---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import gods from '~/data/en/taoist-gods.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { stripBold } from '~/utils/rich-text';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gods/*.{jpeg,jpg,png,gif,webp,avif}', {
  eager: true,
});

const resolveImage = (imagePath: string | undefined): ImageMetadata | null => {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith('/' + filename));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  // EXP-G-001 follow-up (2026-07-04): the 2026-04-27 title "Taoism Gods of
  // Taiwan — Complete Guide" kept impressions flat but dropped CTR to 0%
  // (172 imp / 0 clicks over 28d). "Taoism Gods" is non-native phrasing.
  // Retry with native wording + concrete deity names for information scent.
  title: 'Taoist Deities in Taiwan: Jade Emperor, Mazu & the Gods People Actually Worship',
  ignoreTitleTemplate: true,
  description:
    'Meet the 15 Taoist deities Taiwanese people pray to every day — Mazu for safety, Guan Yu for business, the Jade Emperor above all. Legends, festivals, and where to find their temples.',
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: 'https://www.taiwanese-gods.org/en/gods/taoism',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Guan Sheng Di Jun (Lord Guan)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/guansheng',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Mazu (Goddess of the Sea)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/mazu',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'City God (Cheng Huang)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/chenghuang',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Baosheng Dadi (Great Emperor of Life Protection)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/baosheng',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Earth God (Tu Di Gong)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/tudigong',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: 'Xuantian Shangdi (Supreme Emperor of Dark Heaven)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/xuantian',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: 'Jade Emperor (Yu Huang Da Di)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/yuhuang',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: 'Yue Lao (Old Man Under the Moon)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/yuelao',
      },
      {
        '@type': 'ListItem',
        position: 9,
        name: 'God of Wealth (Cai Shen)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/caishen',
      },
      {
        '@type': 'ListItem',
        position: 10,
        name: 'Ji Gong (Mad Monk)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/jigong',
      },
      {
        '@type': 'ListItem',
        position: 11,
        name: 'Lü Dongbin (Patriarch Lü)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/lvdongbin',
      },
      {
        '@type': 'ListItem',
        position: 12,
        name: 'Tai Sui (Grand Duke Jupiter)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/taisui',
      },
      {
        '@type': 'ListItem',
        position: 13,
        name: 'Wenchang Dijun (God of Culture and Literature)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/wenchang',
      },
      {
        '@type': 'ListItem',
        position: 14,
        name: 'Confucius',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/confucius',
      },
      {
        '@type': 'ListItem',
        position: 15,
        name: 'Queen Mother of the West (Xi Wangmu)',
        url: 'https://www.taiwanese-gods.org/en/gods/taoism/wangmu',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd data={collectionJsonLd} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        Taoist Deities in Taiwan
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        Discover the rich pantheon of Taoist gods revered in Taiwan. Learn about their legends, roles, and the temples
        dedicated to them.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        gods.map((god) => {
          const imageSrc = resolveImage(god.image);
          return (
            <a
              href={`/en/gods/taoism/${god.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-64 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <Image
                    src={imageSrc}
                    alt={god.name}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-paper-texture">No Image</div>
                )}
              </div>
              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {god.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {stripBold(god.description)}
                </p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                    Read More →
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/en"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
