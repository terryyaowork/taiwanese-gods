---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import gods from '~/data/en/folk-gods.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gods/*.{jpeg,jpg,png,gif,webp,avif}', {
  eager: true,
});

const resolveImage = (imagePath: string | undefined): ImageMetadata | null => {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith('/' + filename));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  title: 'Taiwanese Folk Gods & Folk Religion Deities | Taiwanese Gods',
  ignoreTitleTemplate: true,
  description:
    'Explore 13 Taiwanese folk religion gods — Wangye, Nezha, Tiger Lord, Door Gods, and more. Discover their legends, rituals, and the folk temples across Taiwan.',
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: 'https://www.taiwanese-gods.org/en/gods/folk',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Wangye (Plague Lord)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/wangye',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Baosheng Dadi',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/baosheng',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Nezha (Third Prince)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/nezha',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Tiger Lord',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/tigerlord',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Zhusheng Niangniang',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/zhusheng',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: "Tudipo (Earth God's Wife)",
        url: 'https://www.taiwanese-gods.org/en/gods/folk/tudipo',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: 'Wen Wu Dazhong Ye',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/dazhongye',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: 'Kaizhang Shengwang (Sacred King of Zhangzhou)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/kaizhangshengwang',
      },
      {
        '@type': 'ListItem',
        position: 9,
        name: 'Kuixing Ye (Star Lord of Literature)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/kuixing',
      },
      {
        '@type': 'ListItem',
        position: 10,
        name: 'Di Ji Zhu (Foundation Lord)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/dijizhu',
      },
      {
        '@type': 'ListItem',
        position: 11,
        name: 'Qi Niang Ma (Seven Mothers)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/qiniangma',
      },
      {
        '@type': 'ListItem',
        position: 12,
        name: 'Qingshui Zushi (Patriarch of Clear Water)',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/qingshuizushi',
      },
      {
        '@type': 'ListItem',
        position: 13,
        name: 'Door Gods',
        url: 'https://www.taiwanese-gods.org/en/gods/folk/doorgods',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd data={collectionJsonLd} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        Folk Deities in Taiwan
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        Folk deities are closely tied to daily life, guarding homes and communities. Learn about Tudi Gong, the Tiger
        Lord, and other beloved figures.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        gods.map((god) => {
          const imageSrc = resolveImage(god.image);
          return (
            <a
              href={`/en/gods/folk/${god.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-64 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <Image
                    src={imageSrc}
                    alt={god.name}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-paper-texture">No Image</div>
                )}
              </div>
              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {god.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {god.description}
                </p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                    Read More →
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/en"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
