---
import Layout from '~/layouts/PageLayout.astro';
import gods from '~/data/folk-gods.json';

export async function getStaticPaths() {
  return gods.map((god) => ({
    params: { id: god.id },
  }));
}

const labels = {
  'zh-TW': {
    aliases: '別名',
    domain: '職掌',
    description: '簡介',
    story: '神話故事',
    temples: '代表廟宇',
    worship: '參拜方式',
    festivals: '重要慶典',
    back: '← 回神明列表',
  },
  en: {
    aliases: 'Alias',
    domain: 'Domain',
    description: 'Description',
    story: 'Legend/Story',
    temples: 'Representative Temples',
    worship: 'Worship',
    festivals: 'Major Festivals',
    back: '← Back to Deities List',
  },
};

const { id } = Astro.params;
const lang = 'en';
const god = gods.find((g) => g.id === id) as any;
if (!god) {
  throw new Error('Deity not found');
}

const metadata = {
  title: god.name[lang],
  description: god.description[lang].substring(0, 150) + '...',
  openGraph: {
    images: [
      {
        url: god.image,
        width: 1200,
        height: 630,
        alt: god.name[lang],
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <div class="max-w-3xl mx-auto py-8 px-4 sm:px-6">
    <div class="mb-6">
      <a href="/en/gods/folk" class="text-blue-600 hover:underline inline-flex items-center">
        {labels[lang].back}
      </a>
    </div>

    <img
      src={god.image}
      alt={god.name[lang]}
      class="w-full object-cover rounded-lg shadow-md mb-8 max-h-[500px] bg-gray-100"
    />

    <h1 class="text-4xl font-bold mb-6 text-gray-900">{god.name[lang]}</h1>

    <div class="bg-gray-50 p-6 rounded-lg mb-8 border border-gray-100">
      <div class="mb-4 text-lg">
        <span class="font-bold text-gray-700">{labels[lang].aliases}: </span>
        {god.aliases[lang]?.join(', ')}
      </div>
      <div class="text-lg">
        <span class="font-bold text-gray-700">{labels[lang].domain}: </span>
        {god.domain[lang]}
      </div>
    </div>

    <div class="space-y-10">
      <section>
        <h2 class="text-2xl font-bold mb-4 border-b pb-2 text-primary-700">{labels[lang].description}</h2>
        <div class="prose max-w-none text-gray-800 leading-relaxed text-lg">
          {god.description[lang].split('\n').map((line: string) => line.trim() && <p class="mb-4">{line}</p>)}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4 border-b pb-2 text-primary-700">{labels[lang].story}</h2>
        <div class="prose max-w-none text-gray-800 leading-relaxed text-lg">
          {god.story[lang].split('\n').map((line: string) => line.trim() && <p class="mb-4">{line}</p>)}
        </div>
      </section>

      {
        god.worship && god.worship[lang] && (
          <section>
            <h2 class="text-2xl font-bold mb-4 border-b pb-2 text-primary-700">{labels[lang].worship}</h2>
            <div class="prose max-w-none text-gray-800 leading-relaxed text-lg">
              {god.worship[lang].split('\n').map((line: string) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </section>
        )
      }

      {
        god.festivals && god.festivals[lang] && (
          <section>
            <h2 class="text-2xl font-bold mb-4 border-b pb-2 text-primary-700">{labels[lang].festivals}</h2>
            <div class="prose max-w-none text-gray-800 leading-relaxed text-lg">
              {god.festivals[lang].split('\n').map((line: string) => line.trim() && <p class="mb-4">{line}</p>)}
            </div>
          </section>
        )
      }

      <section>
        <h2 class="text-2xl font-bold mb-4 border-b pb-2 text-primary-700">{labels[lang].temples}</h2>
        <ul class="list-none space-y-3">
          {
            god.temples.map((t: any) => (
              <li>
                <a
                  href={t.url}
                  target="_blank"
                  rel="noopener"
                  class="text-blue-600 hover:text-blue-800 hover:underline flex items-center text-lg"
                >
                  <span class="mr-2">⛩️</span> {t.name[lang]} <span class="text-gray-500 ml-2">({t.location})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="mt-12 pt-8 border-t text-center">
      <a href="/en/gods/folk" class="inline-flex items-center text-blue-600 hover:underline text-lg">
        {labels[lang].back}
      </a>
    </div>
  </div>
</Layout>
