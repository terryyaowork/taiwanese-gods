---
import Layout from '~/layouts/PageLayout.astro';
import routes from '~/data/en/routes.json';

const metadata = {
  title: 'Temple Tour Routes in Taiwan | Themed Day Trips',
  description:
    'Ready-made temple tour routes for visiting Taiwan — love, fortune, and first-visit itineraries with MRT directions, prayer guides, and hour-by-hour schedules.',
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        Temple Tour Routes
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        Themed temple itineraries with MRT directions, suggested timing, and what to pray for at each stop — just follow
        along.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        routes.map((route) => (
          <a
            href={`/en/routes/${route.id}`}
            class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1 p-6"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-block px-3 py-1 text-sm rounded-full bg-red-100 dark:bg-red-900/60 text-red-800 dark:text-red-200 font-medium">
                {route.theme}
              </span>
              <span class="text-sm text-gray-500 dark:text-gray-400">
                {route.region} · ~{route.durationHours} hours
              </span>
            </div>
            <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-3 group-hover:text-red-700 transition">
              {route.name}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 font-light leading-relaxed line-clamp-3">{route.summary}</p>
            <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              {route.stops.length} stops · {route.transport}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
