---
/* eslint-disable @typescript-eslint/no-explicit-any */
import Layout from '~/layouts/PageLayout.astro';
import Divination from '~/components/common/Divination.astro';

// Import all god data to build a lookup map
import taoistGods from '~/data/en/taoist-gods.json';
import buddhistGods from '~/data/en/buddhist-gods.json';
import folkGods from '~/data/en/folk-gods.json';
import hakkaGods from '~/data/en/hakka-gods.json';
import indigenousSpirits from '~/data/en/indigenous-spirits.json';
import { buildGodRecommendations, routesIndexHref } from '~/utils/temple-recommendations';

// Resolve all god images at build time
const godImages = import.meta.glob('/src/assets/images/gods/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});

const resolveImage = (imagePath: string) => {
  if (!imagePath) return '';
  const filename = imagePath.split('/').pop();
  const matchedKey = Object.keys(godImages).find((key) => key.endsWith('/' + filename));
  if (!matchedKey) return '';
  const img = godImages[matchedKey];
  return typeof img === 'object' && img !== null && 'src' in img ? (img as any).src : String(img);
};

// Build god map
const allGods = [
  ...taoistGods.map((g: any) => ({ ...g, category: 'taoism' })),
  ...buddhistGods.map((g: any) => ({ ...g, category: 'buddhism' })),
  ...folkGods.map((g: any) => ({ ...g, category: 'folk' })),
  ...hakkaGods.map((g: any) => ({ ...g, category: 'hakka' })),
  ...indigenousSpirits.map((g: any) => ({ ...g, category: 'indigenous' })),
];

const godMap: Record<string, { name: string; imageSrc: string; category: string }> = {};
for (const g of allGods) {
  godMap[g.id] = { name: g.name, imageSrc: resolveImage(g.image), category: g.category };
}

// After drawing: point the reader to a real temple / route
const godRecommendations = buildGodRecommendations('en');
const routesHref = routesIndexHref('en');

const ctaLabels = {
  title: 'Now go in person',
  sub: 'These temples enshrine {god}. Go on a weekday morning — fewer people, and more room to say what you came to say.',
  routesLabel: 'Or follow a quiet route',
  fallbackTitle: 'Not sure where to go?',
  fallbackSub: 'Browse the themed routes and pick a quiet one.',
  fallbackLink: 'Browse routes',
};

const metadata = {
  title: 'Fortune Sticks — Sixty Jiazi Fortune Poems | Taiwanese Deities',
  ignoreTitleTemplate: true,
  description:
    'Draw fortune sticks online with the complete sixty Jiazi fortune poems. Pray sincerely and receive divine guidance.',
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="text-center mb-10">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        Fortune Sticks
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-4"></div>
      <p class="text-gray-600 dark:text-gray-400 font-light max-w-xl mx-auto">
        Focus on your question, cast moon blocks to draw a fortune stick, and receive divine guidance
      </p>
    </div>

    <!-- Two-column Layout: God Info (left) + Divination (right) -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 lg:gap-8 mb-12">
      <!-- Left: God Info -->
      <div class="lg:col-span-2">
        <div
          class="bg-white/95 dark:bg-gray-800/95 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden lg:sticky lg:top-4"
        >
          <!-- God Image -->
          <div class="relative">
            <div
              id="god-avatar-bg"
              class="w-full aspect-[4/3] sm:aspect-square bg-gray-100 dark:bg-gray-700 overflow-hidden"
            >
              <img id="god-avatar-img" src="" alt="" class="w-full h-full object-cover" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
              <h2 id="god-title" class="text-2xl font-serif font-bold text-white drop-shadow-lg"></h2>
            </div>
          </div>

          <!-- Reminder -->
          <div class="p-5 space-y-4">
            <div
              class="bg-amber-50/80 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-lg p-4"
            >
              <p class="text-sm text-amber-800 dark:text-amber-300 leading-relaxed">
                Before praying, silently tell the deity your <strong>name</strong>, <strong>date of birth</strong>, and <strong
                  >address</strong
                >, then sincerely state your question.
              </p>
            </div>

            <a
              id="god-back-link"
              href="#"
              class="hidden items-center gap-1 text-sm text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-400 transition-colors"
            >
              ← Back to deity page
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Divination -->
      <div class="lg:col-span-3">
        <div
          class="bg-white/95 dark:bg-gray-800/95 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 p-4 sm:p-6"
        >
          <Divination lang="en" />
        </div>
      </div>
    </div>

    <!-- Fortune Result Section (hidden by default, shown when fortune is confirmed) -->
    <div id="fortune-result" class="hidden mb-12 animate-fade-in">
      <div class="flex items-center gap-4 mb-8">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-red-300 dark:via-red-700 to-transparent"></div>
        <h2 class="text-2xl font-serif font-bold text-red-900 dark:text-red-300 whitespace-nowrap">Your Fortune</h2>
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-red-300 dark:via-red-700 to-transparent"></div>
      </div>

      <div
        class="max-w-3xl mx-auto bg-white/95 dark:bg-gray-800/95 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden"
      >
        <!-- Fortune Header -->
        <div
          class="bg-gradient-to-r from-red-800 to-red-900 px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between"
        >
          <div>
            <span id="result-stick-number" class="text-white/80 text-sm font-mono"></span>
            <h3 id="result-title" class="text-xl font-serif font-bold text-white"></h3>
          </div>
          <span
            id="result-quality-badge"
            class="px-3 py-1 rounded-full text-sm font-bold bg-white/20 text-white border border-white/30"></span>
        </div>

        <!-- Poem -->
        <div class="px-6 py-6 border-b border-gray-100 dark:border-gray-700">
          <h4 class="text-sm font-bold text-red-800 dark:text-red-400 mb-3 tracking-widest">FORTUNE POEM</h4>
          <p
            id="result-poem"
            class="text-base sm:text-lg font-serif text-gray-800 dark:text-gray-200 leading-loose whitespace-pre-line text-center"
          >
          </p>
        </div>

        <!-- Explanation -->
        <div class="px-6 py-6">
          <h4 class="text-sm font-bold text-red-800 dark:text-red-400 mb-3 tracking-widest">INTERPRETATION</h4>
          <div id="result-explanation" class="text-gray-700 dark:text-gray-300 leading-relaxed space-y-3"></div>

          <!-- Keywords -->
          <div
            id="result-keywords"
            class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-gray-100 dark:border-gray-700"
          >
          </div>
        </div>

        <!-- CTA: go to a real temple / walk a route -->
        <div id="fortune-cta" class="hidden px-6 pb-6">
          <div class="rounded-lg border border-amber-200 dark:border-amber-700 bg-amber-50/70 dark:bg-amber-900/20 p-5">
            <h4 id="fortune-cta-title" class="text-base font-serif font-bold text-red-900 dark:text-red-300 mb-1"></h4>
            <p id="fortune-cta-sub" class="text-sm text-gray-600 dark:text-gray-400 mb-4 leading-relaxed"></p>
            <ul id="fortune-cta-temples" class="space-y-2"></ul>
            <div id="fortune-cta-routes" class="hidden mt-4 pt-4 border-t border-amber-200/70 dark:border-amber-700/50">
              <p id="fortune-cta-routes-label" class="text-xs font-bold text-amber-800 dark:text-amber-300 mb-2"></p>
              <ul id="fortune-cta-routes-list" class="space-y-2"></ul>
            </div>
          </div>
        </div>

        <!-- Draw Again -->
        <div class="px-6 pb-6 text-center">
          <button
            id="btn-draw-again-external"
            class="px-6 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-full transition-colors font-medium text-sm"
          >
            Draw Again
          </button>
        </div>
      </div>
    </div>

    <!-- Back -->
    <div class="text-center">
      <a
        href="/en/"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeInUp 0.5s ease-out;
  }
</style>

<script is:inline define:vars={{ godMap, godRecommendations, ctaLabels, routesHref }}>
  // Recommend a real temple / route after the draw. No enshrining temple → fall back to the
  // routes index; indigenous beliefs are tied to mountains and village sites, not temples → no CTA.
  function renderFortuneCta(godId) {
    const box = document.getElementById('fortune-cta');
    if (!box) return;

    const titleEl = document.getElementById('fortune-cta-title');
    const subEl = document.getElementById('fortune-cta-sub');
    const templeList = document.getElementById('fortune-cta-temples');
    const routesBox = document.getElementById('fortune-cta-routes');
    const routesLabel = document.getElementById('fortune-cta-routes-label');
    const routesList = document.getElementById('fortune-cta-routes-list');
    if (!titleEl || !subEl || !templeList || !routesBox || !routesLabel || !routesList) return;

    const god = godMap[godId];
    if (!god || god.category === 'indigenous') {
      box.classList.add('hidden');
      return;
    }

    templeList.innerHTML = '';
    routesList.innerHTML = '';

    const addItem = function (list, href, name, meta) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = href;
      a.className =
        'flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3 rounded-md bg-white/80 dark:bg-gray-800/60 border border-amber-200/80 dark:border-amber-700/50 px-4 py-2.5 hover:border-red-400 dark:hover:border-red-500 transition-colors';
      const nameEl = document.createElement('span');
      nameEl.className = 'text-sm font-medium text-gray-800 dark:text-gray-200';
      nameEl.textContent = name;
      a.appendChild(nameEl);
      if (meta) {
        const metaEl = document.createElement('span');
        metaEl.className = 'text-xs text-gray-500 dark:text-gray-400';
        metaEl.textContent = meta;
        a.appendChild(metaEl);
      }
      li.appendChild(a);
      list.appendChild(li);
    };

    const rec = godRecommendations[godId];

    if (rec && rec.temples.length > 0) {
      titleEl.textContent = ctaLabels.title;
      subEl.textContent = ctaLabels.sub.replace('{god}', god.name);
      rec.temples.forEach(function (t) {
        addItem(templeList, t.href, t.name, t.location);
      });

      if (rec.routes.length > 0) {
        routesLabel.textContent = ctaLabels.routesLabel;
        rec.routes.forEach(function (r) {
          addItem(routesList, r.href, r.name, '');
        });
        routesBox.classList.remove('hidden');
      } else {
        routesBox.classList.add('hidden');
      }
    } else {
      titleEl.textContent = ctaLabels.fallbackTitle;
      subEl.textContent = ctaLabels.fallbackSub;
      addItem(templeList, routesHref, ctaLabels.fallbackLink, '');
      routesBox.classList.add('hidden');
    }

    box.classList.remove('hidden');
  }

  function populateGodInfo() {
    const el = document.getElementById('god-avatar-img');
    if (!el) return;

    const params = new URLSearchParams(window.location.search);
    const godId = params.get('god') || sessionStorage.getItem('fortune-god') || 'yuhuang';
    if (sessionStorage.getItem('fortune-god')) sessionStorage.removeItem('fortune-god');
    const god = godMap[godId] || godMap['yuhuang'];
    if (!god) return;

    window.__fortuneGodId = godMap[godId] ? godId : 'yuhuang';

    el.src = god.imageSrc;
    el.alt = god.name;

    const titleEl = document.getElementById('god-title');
    if (titleEl) titleEl.textContent = 'Pray to ' + god.name;

    const backLink = document.getElementById('god-back-link');
    if (godId !== 'yuhuang' && backLink) {
      backLink.href = '/en/gods/' + god.category + '/' + godId;
      backLink.classList.remove('hidden');
      backLink.classList.add('flex');
    }

    const resultSection = document.getElementById('fortune-result');
    if (resultSection) resultSection.classList.add('hidden');
  }

  window.__handleFortuneConfirmed = function (e) {
    const fortune = e.detail.fortune;
    const num = e.detail.stickNumber;

    const resultSection = document.getElementById('fortune-result');
    const resultStickNumber = document.getElementById('result-stick-number');
    const resultTitle = document.getElementById('result-title');
    const resultQualityBadge = document.getElementById('result-quality-badge');
    const resultPoem = document.getElementById('result-poem');
    const resultExplanation = document.getElementById('result-explanation');
    const resultKeywords = document.getElementById('result-keywords');

    if (resultStickNumber) resultStickNumber.textContent = 'Stick #' + num + ' · ' + fortune.ganzhi;
    if (resultTitle) resultTitle.textContent = fortune.quality;
    if (resultQualityBadge) resultQualityBadge.textContent = fortune.quality;
    if (resultPoem) resultPoem.textContent = fortune.poem;

    if (resultExplanation) {
      const lines = (fortune.explanation || '').split('\n').filter(function (p) {
        return p.trim();
      });
      let html = '';
      lines.forEach(function (line) {
        const trimmed = line.trim();
        let headerMatch = trimmed.match(/^【([^】]+)】(.*)$/);
        if (!headerMatch) headerMatch = trimmed.match(/^\[([^\]]+)\]\s*(.*)$/);
        if (headerMatch) {
          html +=
            '<div class="mb-3"><span class="inline-block px-2 py-0.5 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-300 text-xs font-bold rounded mr-2 border border-red-200 dark:border-red-700">' +
            (headerMatch[1] || headerMatch[3]) +
            '</span><span>' +
            (headerMatch[2] || headerMatch[4] || '').trim() +
            '</span></div>';
        } else {
          html += '<p class="text-gray-500 dark:text-gray-400 text-sm italic mb-2">' + trimmed + '</p>';
        }
      });
      resultExplanation.innerHTML = html;
    }

    if (resultKeywords && fortune.keywords && fortune.keywords.length > 0) {
      resultKeywords.innerHTML = fortune.keywords
        .map(function (kw) {
          return (
            '<span class="text-xs px-2.5 py-1 bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-700 rounded-full">' +
            kw +
            '</span>'
          );
        })
        .join('');
      resultKeywords.classList.remove('hidden');
    } else if (resultKeywords) {
      resultKeywords.classList.add('hidden');
    }

    renderFortuneCta(window.__fortuneGodId || 'yuhuang');

    if (resultSection) {
      resultSection.classList.remove('hidden');
      setTimeout(function () {
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    }
  };

  if (!window.__fortuneListenersReady) {
    window.__fortuneListenersReady = true;
    document.addEventListener('fortune-confirmed', function (e) {
      if (window.__handleFortuneConfirmed) window.__handleFortuneConfirmed(e);
    });
    document.addEventListener('click', function (e) {
      if (e.target && e.target.id === 'btn-draw-again-external') {
        const rs = document.getElementById('fortune-result');
        if (rs) rs.classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  document.addEventListener('astro:page-load', populateGodInfo);
</script>
