---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import customs from '~/data/zh-TW/culture-customs.json';

export async function getStaticPaths() {
  return customs.map((item) => ({
    params: { id: item.id },
  }));
}

const { id } = Astro.params;
const item = customs.find((c) => c.id === id);
if (!item) {
  throw new Error('民俗資料不存在');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-rituals/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const customImages = import.meta.glob('/src/assets/images/culture-customs/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const allImages = { ...cultureImages, ...customImages };

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(allImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = allImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = item.images?.[0] ? getImage(item.images[0]) : null;
---

<CultureDetail
  item={item}
  imageSrc={imageSrc}
  category="customs"
  categoryLabel="民俗信仰"
  backLink="/culture/customs"
  backLabel="← 返回民俗信仰"
/>
