---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import heritage from '~/data/zh-TW/culture-heritage.json';

export async function getStaticPaths() {
  return heritage.map((item) => ({
    params: { id: item.id },
  }));
}

const { id } = Astro.params;
const item = heritage.find((h) => h.id === id);
if (!item) {
  throw new Error('文化傳承資料不存在');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-heritage/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(cultureImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = cultureImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = item.images?.[0] ? getImage(item.images[0]) : null;
---

<CultureDetail
  item={item}
  imageSrc={imageSrc}
  category="heritage"
  categoryLabel="文化傳承"
  backLink="/culture/heritage"
  backLabel="← 返回文化傳承"
/>
