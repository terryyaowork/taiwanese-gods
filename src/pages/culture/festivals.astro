---
import Layout from '~/layouts/PageLayout.astro';
import festivals from '~/data/zh-TW/culture-festivals.json';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/culture-festivals/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

const resolveImage = (imagePath: string | undefined) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith(filename!));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  title: '節慶活動 | 台灣信仰文化',
  description: '介紹台灣代表性的宗教節慶與民俗活動，包含媽祖遶境、中元普渡、鹽水蜂炮、元宵節等。',
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide">節慶活動</h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        介紹台灣代表性的宗教節慶與民俗活動，感受最熱鬧的台灣傳統文化魅力。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        festivals.map((festival) => {
          const imageSrc = resolveImage(festival.images?.[0]);
          return (
            <a
              href={`/culture/festivals/${festival.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-48 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <img
                    src={imageSrc.src}
                    alt={festival.title}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-gradient-to-br from-red-900/20 to-amber-900/20">
                    <span class="text-4xl">🎊</span>
                  </div>
                )}
              </div>

              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {festival.title}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">{festival.summary}</p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">了解更多 →</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Layout>
