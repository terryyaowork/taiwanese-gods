---
import CultureDetail from '~/components/culture/CultureDetail.astro';
import mantras from '~/data/zh-TW/culture-mantras.json';

export async function getStaticPaths() {
  return mantras.map((item) => ({
    params: { id: item.id },
  }));
}

const { id } = Astro.params;
const item = mantras.find((m) => m.id === id);
if (!item) {
  throw new Error('經典資料不存在');
}

const cultureImages = import.meta.glob('/src/assets/images/culture-mantras/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});

const getImage = (imagePath: string) => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const foundKey = Object.keys(cultureImages).find((key) => key.endsWith(filename || ''));
  if (foundKey) {
    const img = cultureImages[foundKey];
    return typeof img === 'object' && img !== null && 'src' in img ? (img as { src: string }).src : img;
  }
  return null;
};

const imageSrc = item.images?.[0] ? getImage(item.images[0]) : null;
---

<CultureDetail
  item={item}
  imageSrc={imageSrc}
  category="mantras"
  categoryLabel="經典咒語"
  backLink="/culture/mantras"
  backLabel="← 返回經典咒語"
/>
