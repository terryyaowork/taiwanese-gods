---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import gods from '~/data/zh-TW/buddhist-gods.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gods/*.{jpeg,jpg,png,gif,webp,avif}', {
  eager: true,
});

const resolveImage = (imagePath: string | undefined): ImageMetadata | null => {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith('/' + filename));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  title: '佛教信仰神明 | 台灣神明信仰',
  description: '認識台灣佛教信仰神明，如觀世音菩薩、地藏王菩薩等慈悲神佛，感受佛教文化的平靜與智慧。',
  openGraph: {
    images: [
      {
        url: gods[0]?.image || '/assets/images/gods/default.png',
        width: 1200,
        height: 630,
        alt: '佛教信仰神明集合',
      },
    ],
  },
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: 'https://www.taiwanese-gods.org/gods/buddhism',
  inLanguage: 'zh-TW',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '釋迦牟尼佛',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/shakyamuni',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '觀世音菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/guanyin',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: '地藏王菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/kshitigarbha',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: '藥師佛',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/medicine-buddha',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: '韋馱菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/skanda',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: '伽藍菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/sangharama',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: '阿彌陀佛',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/amitabha',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: '彌勒佛',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/maitreya',
      },
      {
        '@type': 'ListItem',
        position: 9,
        name: '文殊菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/manjushri',
      },
      {
        '@type': 'ListItem',
        position: 10,
        name: '普賢菩薩',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/samantabhadra',
      },
      {
        '@type': 'ListItem',
        position: 11,
        name: '不動明王',
        url: 'https://www.taiwanese-gods.org/gods/buddhism/fudomyoo',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd data={collectionJsonLd} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        佛教信仰神明
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        佛教傳入台灣後與在地文化融合。這裡介紹觀世音菩薩、地藏王菩薩等廣受敬奉的佛菩薩。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        gods.map((god) => {
          const imageSrc = resolveImage(god.image);
          return (
            <a
              href={`/gods/buddhism/${god.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-64 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <Image
                    src={imageSrc}
                    alt={god.name}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-paper-texture">No Image</div>
                )}
              </div>

              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {god.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {god.description}
                </p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                    了解更多 →
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        回首頁
      </a>
    </div>
  </div>
</Layout>
