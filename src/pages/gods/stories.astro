---
import Layout from '~/layouts/PageLayout.astro';
import stories from '~/data/zh-TW/god-stories.json';
const metadata = {
  title: '神明故事',
  description: '收錄台灣常見神明的傳奇故事與信仰淵源，深入了解神明的起源傳說與民間信仰故事。',
};
---

<Layout metadata={metadata}>
  <h1 class="text-3xl font-bold mb-4">神明故事</h1>
  <p class="mb-8">收錄台灣常見神明的傳奇故事與信仰淵源。</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      stories.map((story) => (
        <a
          href={`/gods/stories/${story.id}`}
          class="block border rounded-lg p-6 shadow bg-white dark:bg-gray-800 hover:shadow-lg transition"
        >
          {story.images?.[0] && (
            <img
              src={story.images[0]}
              alt={story.title}
              class="w-full h-40 object-cover object-top rounded mb-4"
            />
          )}
          <h2 class="text-xl font-semibold mb-2">{story.title}</h2>
          <div class="mb-1 text-gray-600 dark:text-gray-400">主角神明：{story.mainDeities.map((d) => d.name).join('、')}</div>
          <p class="mb-2 text-gray-700 dark:text-gray-300">{story.summary}</p>
        </a>
      ))
    }
  </div>
</Layout>
