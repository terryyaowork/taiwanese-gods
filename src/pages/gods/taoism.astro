---
import Layout from '~/layouts/PageLayout.astro';
import JsonLd from '~/components/common/JsonLd.astro';
import gods from '~/data/zh-TW/taoist-gods.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gods/*.{jpeg,jpg,png,gif,webp,avif}', {
  eager: true,
});

const resolveImage = (imagePath: string | undefined): ImageMetadata | null => {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith('/' + filename));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  title: '台灣道教主神與神明介紹 | 道教信仰完整指南',
  description:
    '認識台灣15位重要道教主神——玉皇大帝、媽祖、關聖帝君、土地公、城隍爺等，了解道教神明的神職、傳說典故與重要廟宇。',
  openGraph: {
    images: [
      {
        url: gods[0]?.image || '/assets/images/gods/default.png',
        width: 1200,
        height: 630,
        alt: '道教神明集合',
      },
    ],
  },
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: 'https://www.taiwanese-gods.org/gods/taoism',
  inLanguage: 'zh-TW',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '關聖帝君',
        url: 'https://www.taiwanese-gods.org/gods/taoism/guansheng',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '媽祖',
        url: 'https://www.taiwanese-gods.org/gods/taoism/mazu',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: '城隍爺',
        url: 'https://www.taiwanese-gods.org/gods/taoism/chenghuang',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: '保生大帝',
        url: 'https://www.taiwanese-gods.org/gods/taoism/baosheng',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: '土地公',
        url: 'https://www.taiwanese-gods.org/gods/taoism/tudigong',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: '玄天上帝',
        url: 'https://www.taiwanese-gods.org/gods/taoism/xuantian',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: '玉皇大帝',
        url: 'https://www.taiwanese-gods.org/gods/taoism/yuhuang',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: '月下老人',
        url: 'https://www.taiwanese-gods.org/gods/taoism/yuelao',
      },
      {
        '@type': 'ListItem',
        position: 9,
        name: '財神爺',
        url: 'https://www.taiwanese-gods.org/gods/taoism/caishen',
      },
      {
        '@type': 'ListItem',
        position: 10,
        name: '濟公',
        url: 'https://www.taiwanese-gods.org/gods/taoism/jigong',
      },
      {
        '@type': 'ListItem',
        position: 11,
        name: '呂洞賓',
        url: 'https://www.taiwanese-gods.org/gods/taoism/lvdongbin',
      },
      {
        '@type': 'ListItem',
        position: 12,
        name: '太歲星君',
        url: 'https://www.taiwanese-gods.org/gods/taoism/taisui',
      },
      {
        '@type': 'ListItem',
        position: 13,
        name: '文昌帝君',
        url: 'https://www.taiwanese-gods.org/gods/taoism/wenchang',
      },
      {
        '@type': 'ListItem',
        position: 14,
        name: '孔子',
        url: 'https://www.taiwanese-gods.org/gods/taoism/confucius',
      },
      {
        '@type': 'ListItem',
        position: 15,
        name: '王母娘娘',
        url: 'https://www.taiwanese-gods.org/gods/taoism/wangmu',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <JsonLd data={collectionJsonLd} />
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        道教神明介紹
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        這裡將介紹台灣常見的道教神明、信仰特色與相關廟宇。瞭解祂們的故事與職掌，感受台灣道教文化的深厚底蘊。
      </p>
    </div>

    <!-- 道教主神是誰：直接回答「道教信仰的主神」搜尋意圖（GSC 77 曝光、無對應內容段） -->
    <section
      class="max-w-3xl mx-auto mb-12 bg-white/80 dark:bg-gray-800/80 rounded-lg border border-gold-200 p-6 sm:p-8"
    >
      <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-4">道教信仰的主神是誰？</h2>
      <p class="text-gray-700 dark:text-gray-300 font-light leading-relaxed mb-3">
        道教神明體系中，地位最高的是「<strong>三清</strong
        >」——元始天尊、靈寶天尊、道德天尊（太上老君），祂們是道的化身，屬於信仰的最高層。
        不過在台灣的日常祭祀裡，實際統領天地眾神的是「<strong>玉皇上帝</strong>」（民間慣稱天公），
        農曆正月初九「天公生」是台灣最隆重的祭天日子之一。
      </p>
      <p class="text-gray-700 dark:text-gray-300 font-light leading-relaxed">
        而台灣人生活中最常參拜的道教神明，則依照祈求事項各有分工：航海與平安找<a
          href="/gods/taoism/mazu"
          class="text-red-700 dark:text-red-400 underline decoration-gold-300 hover:decoration-red-400">媽祖</a
        >、 事業與義氣拜<a
          href="/gods/taoism/guansheng"
          class="text-red-700 dark:text-red-400 underline decoration-gold-300 hover:decoration-red-400">關聖帝君</a
        >、 土地與財富求<a
          href="/gods/taoism/tudigong"
          class="text-red-700 dark:text-red-400 underline decoration-gold-300 hover:decoration-red-400">土地公</a
        >、 地方司法則歸<a
          href="/gods/taoism/chenghuang"
          class="text-red-700 dark:text-red-400 underline decoration-gold-300 hover:decoration-red-400">城隍爺</a
        >管轄。 下方列出台灣最重要的 15 位道教神明，點進去可以看每一位的由來、傳說與怎麼拜。
      </p>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        gods.map((god) => {
          const imageSrc = resolveImage(god.image);
          return (
            <a
              href={`/gods/taoism/${god.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-64 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <Image
                    src={imageSrc}
                    alt={god.name}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-paper-texture">No Image</div>
                )}
              </div>

              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {god.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {god.description}
                </p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                    了解更多 →
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        回首頁
      </a>
    </div>
  </div>
</Layout>
