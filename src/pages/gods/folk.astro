---
import Layout from '~/layouts/PageLayout.astro';
import gods from '~/data/folk-gods.json';

const metadata = {
  title: '民間信仰神明 | 台灣神明信仰',
  description: '深入了解台灣民間信仰神明，包括土地公、虎爺、地基主等守護鄉土的神祇與祂們的傳說故事。',
  openGraph: {
    images: [
      {
        url: gods[0]?.image || '/assets/images/gods/default.jpg',
        width: 1200,
        height: 630,
        alt: '民間信仰神明集合',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-4 text-gray-900">民間信仰神明</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        民間信仰神明貼近日常生活，守護鄉土與家宅。這裡介紹土地公、虎爺等廣受敬奉的神祇。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        gods.map((god) => (
          <a
            href={`/gods/folk/${god.id}`}
            class="group block bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 transform hover:-translate-y-1"
          >
            <div class="relative h-64 overflow-hidden bg-gray-100">
              {god.image ? (
                <img
                  src={god.image}
                  alt={god.name['zh-TW']}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="flex items-center justify-center h-full text-gray-400">No Image</div>
              )}
            </div>

            <div class="p-6">
              <h2 class="text-2xl font-bold mb-3 text-gray-800 group-hover:text-primary-600 transition-colors">
                {god.name['zh-TW']}
              </h2>
              <p class="text-gray-600 line-clamp-3 leading-relaxed">{god.description['zh-TW']}</p>
              <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                <span class="text-sm text-gray-500 font-medium">了解更多 →</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/"
        class="inline-block px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition-colors font-medium"
      >
        回首頁
      </a>
    </div>
  </div>
</Layout>
