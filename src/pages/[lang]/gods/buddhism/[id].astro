---
import GodDetail from '~/components/gods/GodDetail.astro';

const allData = import.meta.glob('/src/data/*/buddhist-gods.json', { eager: true, import: 'default' });

export async function getStaticPaths() {
  const allData = import.meta.glob('/src/data/*/buddhist-gods.json', { eager: true, import: 'default' });
  const langs = ['zh-TW', 'en', 'ja'];
  const paths: { params: { lang: string; id: string } }[] = [];
  for (const lang of langs) {
    const gods = (allData[`/src/data/${lang}/buddhist-gods.json`] || []) as any[];
    for (const god of gods) {
      paths.push({ params: { lang, id: god.id } });
    }
  }
  return paths;
}

const { lang: rawLang, id } = Astro.params;
const lang = rawLang || 'zh-TW';
const zhGods = allData['/src/data/zh-TW/buddhist-gods.json'] as any[];
const gods = (allData[`/src/data/${lang}/buddhist-gods.json`] || zhGods) as any[];
const god = gods.find((g: any) => g.id === id);
if (!god) {
  throw new Error('神明資料不存在');
}

const godImages = import.meta.glob('/src/assets/images/gods/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});

const getGodImage = (imagePath: string | undefined): string | null => {
  if (!imagePath) return null;
  const filename = imagePath.split('/').pop();
  const matchedKey = Object.keys(godImages).find((key) => key.endsWith('/' + filename));
  if (matchedKey) {
    const img = godImages[matchedKey];
    if (typeof img === 'object' && img !== null && 'src' in img) {
      return (img as { src: string }).src;
    }
    return String(img);
  }
  return imagePath;
};

const godImageSrc = getGodImage(god.image) || god.image;
---

<GodDetail god={{...god, category: 'buddhism'}} imageSrc={godImageSrc} lang={lang} />
