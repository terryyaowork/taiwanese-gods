---
import Layout from '~/layouts/PageLayout.astro';
import north from '~/data/ja/temples-north.json';
import central from '~/data/ja/temples-central.json';
import south from '~/data/ja/temples-south.json';
import east from '~/data/ja/temples-east.json';

const regions = [
  { slug: 'north', name: '北部の廟', temples: north },
  { slug: 'central', name: '中部の廟', temples: central },
  { slug: 'south', name: '南部の廟', temples: south },
  { slug: 'east', name: '東部・離島', temples: east },
];

const total = regions.reduce((n, r) => n + r.temples.length, 0);

const metadata = {
  title: `台湾の廟一覧：${total} 軒の主祀神と参拝情報`,
  ignoreTitleTemplate: true,
  description: `北部・中部・南部・東部と離島、訪れる価値のある ${total} 軒の台湾の廟を、主祀神・住所・参拝の見どころとともに紹介します。`,
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        台湾の廟一覧
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        台湾の廟の密度は世界でも稀です。ここでは {total} 軒を地域別に四つに分けて紹介します。
      </p>
    </div>

    <div class="space-y-10">
      {
        regions.map((region) => (
          <section class="bg-white/90 dark:bg-gray-800/90 rounded-lg border border-gold-200 shadow-lg p-6">
            <div class="flex flex-wrap items-baseline gap-3 mb-4">
              <a
                href={`/ja/temples/${region.slug}`}
                class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 hover:text-red-700 transition"
              >
                {region.name}
              </a>
              <span class="text-sm text-gray-500 dark:text-gray-400">{region.temples.length} 軒</span>
            </div>
            <ul class="flex flex-wrap gap-x-4 gap-y-2">
              {region.temples.map((temple) => (
                <li>
                  <a
                    href={`/ja/temples/${temple.id}`}
                    class="text-gray-700 dark:text-gray-300 hover:text-red-700 dark:hover:text-red-300 underline decoration-gold-300 underline-offset-4 transition"
                  >
                    {temple.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Layout>
