---
import Layout from '~/layouts/PageLayout.astro';
import gods from '~/data/ja/hakka-gods.json';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/gods/*.{jpeg,jpg,png,gif,webp,avif}', {
  eager: true,
});

const resolveImage = (imagePath: string | undefined): ImageMetadata | null => {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return null;
  const filename = imagePath.split('/').pop();
  const matchedPath = Object.keys(images).find((path) => path.endsWith('/' + filename));
  return matchedPath ? images[matchedPath].default : null;
};

const metadata = {
  title: '客家の信仰 | 台湾の神様紹介',
  ignoreTitleTemplate: true,
  description: '三山国王、義民爺など、台湾における客家独自の信仰文化をご紹介します。',
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1
        class="text-2xl sm:text-4xl md:text-5xl font-serif font-bold text-red-900 dark:text-red-300 mb-4 tracking-wide"
      >
        客家の信仰
      </h1>
      <div class="w-24 h-1 bg-gold-300 mx-auto mb-6"></div>
      <p class="text-lg text-gray-700 dark:text-gray-300 font-light max-w-2xl mx-auto">
        客家の人々は故郷の神様を台湾に持ち込み、コミュニティの絆と精神的な力を育む独自の信仰文化を発展させました。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {
        gods.map((god) => {
          const imageSrc = resolveImage(god.image);
          return (
            <a
              href={`/ja/gods/hakka/${god.id}`}
              class="group block bg-white/90 dark:bg-gray-800/90 rounded-lg overflow-hidden border border-gold-200 shadow-lg hover:shadow-2xl hover:border-red-400 transition duration-300 transform hover:-translate-y-1"
            >
              <div class="relative h-64 overflow-hidden">
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10" />
                {imageSrc ? (
                  <Image
                    src={imageSrc}
                    alt={god.name}
                    width={400}
                    height={300}
                    class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-110"
                  />
                ) : (
                  <div class="flex items-center justify-center h-full text-gold-300 bg-paper-texture">画像なし</div>
                )}
              </div>

              <div class="p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-serif font-bold text-red-900 dark:text-red-300 mb-2 group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                  {god.name}
                </h2>
                <p class="text-gray-600 dark:text-gray-400 font-light line-clamp-3 leading-relaxed">
                  {god.description}
                </p>
                <div class="mt-4 pt-4 border-t border-gold-200/30 flex justify-between items-center">
                  <span class="text-sm text-gold-500 font-medium group-hover:text-red-700 dark:group-hover:text-red-400 transition">
                    詳しく見る →
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="/ja"
        class="inline-block px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium"
      >
        ホームに戻る
      </a>
    </div>
  </div>
</Layout>
