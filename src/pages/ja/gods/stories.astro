---
import Layout from '~/layouts/PageLayout.astro';
import stories from '~/data/ja/god-stories.json';
const metadata = {
  title: '神様の物語 | 台湾の神様紹介',
  ignoreTitleTemplate: true,
  description: '台湾で広く信仰される神様にまつわる伝説と由来をまとめた物語集です。神話と文化的意義を探ります。',
};
---

<Layout metadata={metadata}>
  <h1 class="text-3xl font-bold mb-4">神様の物語</h1>
  <p class="mb-8">台湾の神様にまつわる伝説と由来の物語集です。</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      stories.map((story) => (
        <a
          href={`/ja/gods/stories/${story.id}`}
          class="block border rounded-lg p-6 shadow bg-white dark:bg-gray-800 hover:shadow-lg transition"
        >
          {story.images?.[0] && (
            <img src={story.images[0]} alt={story.title} class="w-full h-40 object-cover object-top rounded mb-4" />
          )}
          <h2 class="text-xl font-semibold mb-2">{story.title}</h2>
          <div class="mb-1 text-gray-600 dark:text-gray-400">
            主な神様: {story.mainDeities.map((d) => d.name).join(', ')}
          </div>
          <p class="mb-2 text-gray-700 dark:text-gray-300">{story.summary}</p>
        </a>
      ))
    }
  </div>
</Layout>
